+# frozen_string_literal: true
+
+RSpec.describe Lain::Image do
+  let(:png) { ImageFixtures.png }
+
+  describe ".block" do
+    it "carries the bytes as base64 text under the media type the bytes declare" do
+      block = described_class.block(png)
+
+      expect(block).to eq("type" => "image",
+                          "source" => { "type" => "base64", "media_type" => "image/png",
+                                        "data" => [png].pack("m0") })
+    end
+
+    # The premise of the inline shape: Canonical admits it, so an Event can hold
+    # it and a digest can name it, and the result is deeply frozen.
+    it "survives Canonical.normalize as a shareable value" do
+      normalized = Lain::Canonical.normalize([described_class.block(png)])
+
+      expect(Ractor.shareable?(normalized)).to be(true)
+      expect(Lain::Canonical.digest(normalized)).to start_with("blake3:")
+    end
+
+    it "passes the tool_result text check a binary String would fail" do
+      result = Lain::Tool::Result.ok([{ "type" => "text", "text" => "shot" }, described_class.block(png)])
+
+      expect(Lain::Tool::ResultBlock::Text.committable(result)).to equal(result)
+    end
+
+    it "refuses bytes that are no image it can name" do
+      expect { described_class.block("%PDF-1.7") }.to raise_error(described_class::UnknownMediaType, /8 bytes/)
+    end
+  end
+
+  describe ".media_type" do
+    {
+      "image/jpeg" => "\xFF\xD8\xFF\xE0rest".b,
+      "image/gif" => "GIF89a....",
+      "image/webp" => "RIFF\x00\x00\x00\x00WEBPVP8 ".b
+    }.each do |type, bytes|
+      it "sniffs #{type} from its signature" do
+        expect(described_class.media_type(bytes)).to eq(type)
+      end
+    end
+  end
+
+  describe ".each_in" do
+    it "finds images at the top level and inside a tool_result's content" do
+      top = described_class.block(png)
+      nested = described_class.block(png.dup)
+      content = [{ "type" => "text", "text" => "a" }, top,
+                 { "type" => "tool_result", "tool_use_id" => "c", "is_error" => false, "content" => [nested] }]
+
+      expect(described_class.each_in(content).to_a).to eq([top, nested])
+    end
+
+    it "finds nothing in String content" do
+      expect(described_class.each_in("just text").to_a).to eq([])
+    end
+  end
+
+  describe ".data" do
+    it "refuses a reference, which only a blob store can turn into bytes" do
+      reference = { "type" => "image", "source" => { "type" => "blob", "digest" => "blake3:00" } }
+
+      expect { described_class.data(reference) }.to raise_error(described_class::Unresolved)
+    end
+  end
+
+  describe ".anthropic_tokens" do
+    it "prices a 1280x800 screenshot by its pixels" do
+      expect(described_class.anthropic_tokens(1280, 800)).to eq(1366)
+    end
+
+    it "prices a long edge past 1568px as if scaled down to it" do
+      expect(described_class.anthropic_tokens(3136, 1568)).to eq(described_class.anthropic_tokens(1568, 784))
+    end
+  end
+end
