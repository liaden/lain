+++ b/lib/lain/telemetry/images_withheld.rb
@@ -0,0 +1,17 @@
+# frozen_string_literal: true
+
+module Lain
+  module Telemetry
+    # Image blocks a request carried were replaced by placeholder text because
+    # the model it went to cannot see. The turn the model answered is then not
+    # the turn the Timeline holds, which is the divergence a comparison must be
+    # able to find -- so it is journaled per request, never inferred.
+    ImagesWithheld = Data.define(:model, :count) do
+      include Journalable
+
+      def initialize(model:, count:)
+        super(model: model.dup.freeze, count:)
+      end
+    end
+  end
+end
