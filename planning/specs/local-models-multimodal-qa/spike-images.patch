+
+RSpec.describe Lain::Tools::Screenshot do
+  # Stands in for Chromium: records the argv it was built with and, when told
+  # to, writes a picture where `--screenshot=` asked for one.
+  let(:launches) { [] }
+
+  def browser(writes: ImageFixtures.png, exitstatus: 0)
+    launched = launches
+    lambda do |*argv, timeout:|
+      launched << { argv:, timeout: }
+      target = argv.find { |arg| arg.start_with?("--screenshot=") }.delete_prefix("--screenshot=")
+      Struct.new(:exitstatus) { def run_command = self }.new(exitstatus).tap do
+        File.binwrite(target, writes) if writes
+      end
+    end
+  end
+
+  def tool(**) = described_class.new(shell_out_factory: browser(**))
+
+  it "returns a caption and an image block, in that order" do
+    result = tool.call({ "url" => "https://example.com" })
+
+    expect(result).to be_ok
+    expect(result.content.first["text"]).to start_with("https://example.com rendered at 1280x800")
+    expect(result.content.last).to eq(Lain::Image.block(ImageFixtures.png))
+  end
+
+  it "renders at the viewport asked for, with a fresh profile and the URL last" do
+    tool.call({ "url" => "https://example.com", "width" => 390, "height" => 844 })
+
+    argv = launches.first[:argv]
+    expect(argv).to include("--window-size=390,844", "--headless")
+    expect(argv.find { |arg| arg.start_with?("--user-data-dir=") }).to end_with("/profile")
+    expect(argv.last).to eq("https://example.com")
+  end
+
+  it "stands a full page in for a tall window" do
+    tool.call({ "url" => "https://example.com", "full_page" => true })
+
+    expect(launches.first[:argv]).to include("--window-size=1280,#{described_class::FULL_PAGE_HEIGHT}")
+  end
+
+  it "refuses a scheme the web does not serve, launching nothing" do
+    result = tool.call({ "url" => "file:///etc/passwd" })
+
+    expect(result).to be_error
+    expect(result.content).to include('got "file"')
+    expect(launches).to be_empty
+  end
+
+  it "refuses a viewport that is not a screen" do
+    expect { tool.call({ "url" => "https://example.com", "width" => 20_000 }) }
+      .to raise_error(Lain::Tool::InvalidInput, /Width must be less than or equal to 1920/)
+  end
+
+  it "reports a browser that left no picture as an error" do
+    result = tool(writes: nil, exitstatus: 1).call({ "url" => "https://example.com" })
+
+    expect(result).to be_error
+    expect(result.content).to include("exited 1 without a picture")
+  end
+
+  it "refuses a picture over its byte ceiling, carrying none of it" do
+    heavy = ImageFixtures.png + ("\0" * Lain::Tool::Bounds::IMAGE_BYTES)
+    result = tool(writes: heavy).call({ "url" => "https://example.com" })
+
+    expect(result).to be_error
+    expect(result.content).to be_a(String).and include("over the ceiling", "smaller width")
+  end
+
+  # It launches a browser that fetches whatever the page asks for, so the
+  # destination is the human's call; the command axis alone would say tier 2.
+  it "asks for approval" do
+    expect(described_class.new.requires_approval?).to be(true)
+  end
+
+  it "survives the commit path's text check whole" do
+    result = tool.call({ "url" => "https://example.com" })
+
+    expect(Lain::Tool::ResultBlock::Text.committable(result)).to equal(result)
+  end
+
+  # The real browser against a real local socket: what the doubles above
+  # assume about Chromium's CLI -- a PNG at the path, exit 0 -- checked once.
+  describe "against headless Chromium", :seam do
+    around do |example|
+      skip "no #{described_class::CHROMIUM}" unless File.executable?(described_class::CHROMIUM)
+
+      server = TCPServer.new("127.0.0.1", 0)
+      page = "<html><body style='background:#1a4fd6'>blue</body></html>"
+      responder = Thread.new do
+        loop do
+          client = server.accept
+          client.readpartial(4096)
+          client.write("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: #{page.bytesize}\r\n" \
+                       "Connection: close\r\n\r\n#{page}")
+          client.close
+        rescue IOError, SystemCallError
+          nil
+        end
+      end
+      @url = "http://127.0.0.1:#{server.addr[1]}/"
+      example.run
+    ensure
+      responder&.kill
+      server&.close
+    end
+
+    it "returns a PNG of the viewport it asked for" do
+      result = described_class.new.call({ "url" => @url, "width" => 640, "height" => 400 })
+
+      image = result.content.last
+      bytes = image.dig("source", "data").unpack1("m0")
+      expect(result).to be_ok
+      expect(image.dig("source", "media_type")).to eq("image/png")
+      expect(bytes.byteslice(16, 8).unpack("NN")).to eq([640, 400])
+    end
+  end
+end
