diff --git a/lib/lain/tools/screenshot.rb b/lib/lain/tools/screenshot.rb
new file mode 100644
--- /dev/null
+++ b/lib/lain/tools/screenshot.rb
@@ -0,0 +1,144 @@
+# frozen_string_literal: true
+
+require "tmpdir"
+require "uri"
+
+module Lain
+  module Tools
+    # Renders one URL in headless Chromium and returns the picture as an
+    # {Image} block beside a line of text saying what was captured.
+    #
+    # Tier 2 by the command axis -- an argv Array, no model-controlled command
+    # string -- and gated anyway, because the axis that decides here is the
+    # other one {WebFetch} names: egress. WebFetch's safety is structural (the
+    # host is checked on every hop, the body is capped as it streams) and none
+    # of that transfers. The URL is checked once, and then a browser fetches
+    # whatever the page asks for, runs its scripts, and follows its redirects,
+    # none of which this process sees. So a human approves the destination.
+    #
+    # Chromium's CLI cannot say whether the navigation worked: an unresolvable
+    # host, a refused port and a 404 all exit 0 and write a picture of
+    # Chromium's own error page. The model can read that page, and the result
+    # says the status is unknown rather than implying success.
+    class Screenshot < Tool
+      CHROMIUM = "/usr/bin/chromium"
+      ALLOWED_SCHEMES = WebFetch::ALLOWED_SCHEMES
+
+      DEFAULT_WIDTH = 1280
+      DEFAULT_HEIGHT = 800
+
+      # The CLI captures the window and nothing below it, so a "full page" is
+      # a tall window: short pages come back padded with blank, long ones cut.
+      # A real full-page capture needs the DevTools protocol.
+      FULL_PAGE_HEIGHT = 4096
+
+      # What a picture may weigh. Its token cost is set by its pixels (see
+      # {Image.anthropic_tokens}), so this bounds the request's BYTES -- the
+      # journal, the wire, Anthropic's 5MB-per-image ceiling on the base64 --
+      # and is a different question from the 16 KiB text row, which it
+      # deliberately does not share.
+      BOUND = Tool::Bounds::Artifact.new(limit: Tool::Bounds::CEILINGS.fetch("screenshot"))
+
+      # Chromium's own startup is ~1.3s here; the rest is the page.
+      TIMEOUT = 30
+
+      # The wire shape: a URL, and the window it is rendered in.
+      class Input < Tool::Input
+        field :url, :string, required: true, description: "Absolute http(s) URL to render."
+        field :width, :integer, description: "Viewport width in CSS pixels. Defaults to #{DEFAULT_WIDTH}."
+        field :height, :integer, description: "Viewport height in CSS pixels. Defaults to #{DEFAULT_HEIGHT}."
+        field :full_page, :boolean,
+              description: "Capture a #{FULL_PAGE_HEIGHT}px-tall window instead of the viewport height. " \
+                           "Longer pages are still cut at that height."
+
+        # Shape, not safety: a viewport outside these is not a screen.
+        validates :width, numericality: { greater_than_or_equal_to: 320, less_than_or_equal_to: 1920 }, allow_nil: true
+        validates :height, numericality: { greater_than_or_equal_to: 200, less_than_or_equal_to: 1600 },
+                           allow_nil: true
+      end
+
+      input_model Input
+
+      # @param shell_out_factory [#call] `(*argv, timeout:) -> #run_command`,
+      #   the {Shell::Out} surface
+      # @param scratch [#call] yields a private directory and removes it after
+      def initialize(shell_out_factory: Shell::Out.public_method(:new), scratch: Dir.method(:mktmpdir))
+        super()
+        @shell_out_factory = shell_out_factory
+        @scratch = scratch
+      end
+
+      def name = "screenshot"
+
+      def description
+        "Renders a web page in a headless browser and returns a picture of it, for questions about how a " \
+          "page LOOKS -- layout, styling, a chart, an error dialog. For what a page SAYS, web_fetch is cheaper " \
+          "and exact. Loads the page's scripts and subresources, so it asks the human first. A failed load is " \
+          "not reported as an error: you get a picture of the browser's error page, so read it."
+      end
+
+      def requires_approval? = true
+
+      protected
+
+      def perform(input, _invocation)
+        refusal = refused(input.url)
+        return Tool::Result.error(refusal) if refusal
+
+        width, height = viewport(input)
+        @scratch.call("lain-screenshot") { |dir| capture(input.url, width, height, dir) }
+      end
+
+      private
+
+      def refused(url)
+        scheme = URI.parse(url).scheme.to_s.downcase
+        "screenshot: only #{ALLOWED_SCHEMES.join("/")} URLs can be rendered, got #{scheme.inspect}" \
+          unless ALLOWED_SCHEMES.include?(scheme)
+      rescue URI::InvalidURIError
+        "screenshot: #{url.inspect} is not a URL"
+      end
+
+      def viewport(input)
+        width = input.width || DEFAULT_WIDTH
+        [width, input.full_page ? FULL_PAGE_HEIGHT : (input.height || DEFAULT_HEIGHT)]
+      end
+
+      def capture(url, width, height, dir)
+        png = File.join(dir, "shot.png")
+        run = @shell_out_factory.call(*argv(url, width, height, dir, png), timeout: TIMEOUT).run_command
+        return failed(run) unless run.exitstatus.zero? && File.exist?(png)
+
+        delivered(url, width, height, File.binread(png))
+      rescue Shell::Out::Timeout
+        Tool::Result.error("screenshot: #{url} did not render within #{TIMEOUT}s")
+      end
+
+      # A fresh profile per call, so no cookie, cache entry or login outlives
+      # it; the scratch directory holding it goes with the picture.
+      def argv(url, width, height, dir, png)
+        [CHROMIUM, "--headless", "--disable-gpu", "--hide-scrollbars", "--no-first-run", "--mute-audio",
+         "--user-data-dir=#{File.join(dir, "profile")}", "--screenshot=#{png}", "--window-size=#{width},#{height}",
+         url]
+      end
+
+      def failed(run)
+        Tool::Result.error("screenshot: the browser exited #{run.exitstatus.inspect} without a picture")
+      end
+
+      def delivered(url, width, height, bytes)
+        unless BOUND.admits?(bytes.bytesize)
+          return BOUND.refusal(subject: "the picture of #{url}", size: bytes.bytesize,
+                               narrower: ["ask for a smaller width and height", "drop full_page"])
+        end
+
+        Tool::Result.ok([{ "type" => "text", "text" => caption(url, width, height, bytes) }, Image.block(bytes)])
+      end
+
+      def caption(url, width, height, bytes)
+        "#{url} rendered at #{width}x#{height} (#{bytes.bytesize} bytes of PNG). The page's HTTP status is not " \
+          "known; if the picture is a browser error page, the load failed."
+      end
+    end
+  end
+end
