diff --git a/lib/lain/image/admission.rb b/lib/lain/image/admission.rb
new file mode 100644
--- /dev/null
+++ b/lib/lain/image/admission.rb
@@ -0,0 +1,85 @@
+# frozen_string_literal: true
+
+module Lain
+  module Image
+    # What happens to image blocks bound for a model that cannot see them, as
+    # the two strategies {Capability::Policy} already names.
+    #
+    # `:strict` refuses by name before the wire. Without it the refusal still
+    # comes -- ollama answers 400 "Multimodal data provided, but model does not
+    # support multimodal requests" -- but only after loading the model, and
+    # naming neither the model nor where the image came from.
+    #
+    # `:degrade` swaps each image for a placeholder sentence the model CAN
+    # read, and journals {Telemetry::ImagesWithheld}. Its honest use is
+    # history: a session that switched to a blind model mid-run still holds
+    # the screenshots an earlier model took, and refusing every later request
+    # for them would end the session over something nobody is asking about.
+    #
+    # Pure over the messages: the Timeline keeps the images, and only what
+    # leaves for this one request changes.
+    class Admission
+      class Blind < Error; end
+
+      POLICIES = %i[strict degrade].freeze
+
+      # @param policy [Symbol] one of {POLICIES}
+      # @param journal [#<<] where a degrade is recorded
+      def initialize(policy:, journal: Channel::Null.instance)
+        raise ArgumentError, "unknown image policy #{policy.inspect}, expected one of #{POLICIES.inspect}" \
+          unless POLICIES.include?(policy)
+
+        @policy = policy
+        @journal = journal
+        freeze
+      end
+
+      # @param messages [Array<Hash>] a Request's messages
+      # @param model [String]
+      # @param vision [Provider::Vision]
+      # @return [Array<Hash>] the messages as they may be sent
+      # @raise [Blind] under `:strict`, when the model is blind and an image is present
+      def admit(messages, model:, vision:)
+        return messages unless vision.blind?
+
+        count = messages.sum { |message| Image.each_in(message["content"]).count }
+        return messages if count.zero?
+
+        @policy == :strict ? refuse(model, count) : withhold(messages, model, count)
+      end
+
+      private
+
+      def refuse(model, count)
+        raise Blind, "#{count} image block(s) are bound for #{model}, whose capabilities do not include " \
+                     "vision -- switch to a model that lists it, or run with the image policy :degrade"
+      end
+
+      def withhold(messages, model, count)
+        @journal << Telemetry::ImagesWithheld.new(model:, count:)
+        messages.map { |message| message.merge("content" => placeholders(message["content"], model)) }
+      end
+
+      def placeholders(content, model)
+        return content unless content.is_a?(Array)
+
+        content.map { |block| substitute(block, model) }
+      end
+
+      def substitute(block, model)
+        return placeholder(block, model) if Image.image?(block)
+        return block unless Image.tool_result?(block)
+
+        block.merge("content" => placeholders(block["content"], model))
+      end
+
+      # States what was there and why it is not, so the model neither pretends
+      # to have seen it nor re-takes a screenshot it will be blind to again.
+      def placeholder(block, model)
+        { "type" => "text",
+          "text" => "[an image (#{block.dig("source", "media_type")}) was here; #{model} cannot see images, " \
+                    "so it was withheld from this request]" }
+      end
+    end
+  end
+end
diff --git a/lib/lain/image/blobs.rb b/lib/lain/image/blobs.rb
new file mode 100644
--- /dev/null
+++ b/lib/lain/image/blobs.rb
@@ -0,0 +1,102 @@
+# frozen_string_literal: true
+
+require "fileutils"
+
+module Lain
+  module Image
+    # Image bytes stored once, by content address, so a Timeline can hold a
+    # reference block instead of the base64 itself:
+    #
+    #   { "type" => "image",
+    #     "source" => { "type" => "blob", "media_type" => "image/png", "digest" => "blake3:4ce4..." } }
+    #
+    # {Canonical} then hashes the reference, and the digest inside it commits
+    # the Event to the exact bytes -- the Merkle property survives without the
+    # bytes riding the chain. What pays for that is one resolution step: an
+    # encoder must call {#inline} on the way to the wire, because no provider
+    # knows what a blob is.
+    #
+    # The digest is BLAKE3 over the RAW bytes, not over a canonical form: the
+    # blob is not a JSON value, and hashing its base64 would make the address
+    # depend on a transport encoding.
+    #
+    # A directory rather than the Store because the Store is in-memory and the
+    # session file is the durable record; a blob directory beside the sessions
+    # directory keeps both `lain resume` and a fork resolving the same digests,
+    # and dedupes a screenshot taken twice.
+    class Blobs
+      class Missing < Error; end
+      class Corrupt < Error; end
+
+      # @param root [String] the directory blobs live under, fanned out by the
+      #   first two hex digits as git does
+      def initialize(root:)
+        @root = root
+        freeze
+      end
+
+      # @param bytes [String]
+      # @return [String] the blob's digest, `"blake3:<hex>"`
+      def put(bytes)
+        digest = digest_of(bytes)
+        path = path_for(digest)
+        write(path, bytes) unless File.exist?(path)
+        digest
+      end
+
+      # @raise [Missing] when no blob has this digest
+      # @raise [Corrupt] when the bytes on disk no longer hash to it
+      def fetch(digest)
+        path = path_for(digest)
+        raise Missing, "no image blob #{digest}" unless File.exist?(path)
+
+        bytes = File.binread(path)
+        raise Corrupt, "image blob #{digest} does not hash to its own name" unless digest_of(bytes) == digest
+
+        bytes
+      end
+
+      # @param bytes [String]
+      # @return [Hash] a frozen reference block
+      def reference(bytes)
+        source = { "type" => BLOB, "media_type" => Image.media_type(bytes), "digest" => put(bytes) }
+        { "type" => TYPE, "source" => source.freeze }.freeze
+      end
+
+      # A content value with every reference replaced by the inline block its
+      # bytes make, at any depth a block nests. What an encoder calls last.
+      #
+      # @param content [String, Array, Hash]
+      def inline(content)
+        case content
+        when Array then content.map { |node| inline(node) }
+        when Hash then reference?(content) ? Image.block(fetch(content.dig("source", "digest"))) : inline_hash(content)
+        else content
+        end
+      end
+
+      private
+
+      def inline_hash(hash) = hash.transform_values { |value| inline(value) }
+
+      def reference?(block) = Image.image?(block) && block.dig("source", "type") == BLOB
+
+      def digest_of(bytes) = "#{Canonical::DIGEST_ALGORITHM}:#{Lain::Ext.blake3_hex(bytes.b)}"
+
+      def path_for(digest)
+        hex = digest.delete_prefix("#{Canonical::DIGEST_ALGORITHM}:")
+        raise ArgumentError, "not a blake3 digest" unless hex.match?(/\A\h{64}\z/)
+
+        File.join(@root, hex[0, 2], hex)
+      end
+
+      # Written beside and renamed, so a reader never sees half a blob.
+      def write(path, bytes)
+        FileUtils.mkdir_p(File.dirname(path))
+        partial = "#{path}.#{Process.pid}.partial"
+        File.binwrite(partial, bytes)
+        File.rename(partial, path)
+      end
+    end
+  end
+end
diff --git a/lib/lain/image.rb b/lib/lain/image.rb
new file mode 100644
--- /dev/null
+++ b/lib/lain/image.rb
@@ -0,0 +1,107 @@
+# frozen_string_literal: true
+
+module Lain
+  # An image as lain's neutral content form carries it: an Anthropic-shaped
+  # block, string-keyed like every other block, so a user turn, a tool_result's
+  # content Array and a Context render all hold one without a new type.
+  #
+  #   { "type" => "image",
+  #     "source" => { "type" => "base64", "media_type" => "image/png", "data" => "iVBOR..." } }
+  #
+  # The bytes ride as base64 TEXT because {Canonical.normalize} admits UTF-8
+  # Strings and nothing binary. Base64's alphabet is ASCII, so the block also
+  # passes {Tool::ResultBlock::Text}'s check unchanged and hashes like any other.
+  #
+  # The second source shape, `"type" => "blob"`, names the bytes by digest
+  # instead of carrying them -- see {Image::Blobs}. It is the one a Timeline
+  # should hold: an inline block rides every later `request_sent` whole.
+  module Image
+    class UnknownMediaType < Error; end
+    class Unresolved < Error; end
+
+    TYPE = "image"
+    BASE64 = "base64"
+    BLOB = "blob"
+    TOOL_RESULT = "tool_result"
+
+    # Sniffed from the bytes rather than taken from a file name or a caller's
+    # word: the provider checks the declared type against the bytes, and a
+    # mismatch is a 400 far from whoever mislabelled it.
+    SIGNATURES = {
+      "image/png" => "\x89PNG\r\n\x1A\n".b,
+      "image/jpeg" => "\xFF\xD8\xFF".b,
+      "image/gif" => "GIF8".b
+    }.freeze
+    WEBP = "image/webp"
+
+    class << self
+      # @param bytes [String] the encoded image, whatever its encoding tag
+      # @return [Hash] a frozen inline image block
+      # @raise [UnknownMediaType] unless the bytes are PNG, JPEG, GIF or WebP
+      def block(bytes)
+        source = { "type" => BASE64, "media_type" => media_type(bytes), "data" => base64(bytes) }
+        { "type" => TYPE, "source" => source.freeze }.freeze
+      end
+
+      # @raise [UnknownMediaType]
+      def media_type(bytes)
+        raw = bytes.b
+        found = SIGNATURES.find { |_, magic| raw.start_with?(magic) }&.first
+        found || webp(raw) || raise(UnknownMediaType, "not a PNG, JPEG, GIF or WebP image (#{raw.bytesize} bytes)")
+      end
+
+      def image?(block) = block.is_a?(Hash) && block["type"] == TYPE
+
+      def tool_result?(block) = block.is_a?(Hash) && block["type"] == TOOL_RESULT
+
+      # Every image block in a content value, including those nested in a
+      # tool_result's content Array -- the one place a block nests today.
+      #
+      # @param content [String, Array<Hash>]
+      # @return [Enumerator<Hash>]
+      def each_in(content, &)
+        return enum_for(:each_in, content) unless block_given?
+        return unless content.is_a?(Array)
+
+        content.each do |block|
+          yield block if image?(block)
+          each_in(block["content"], &) if tool_result?(block)
+        end
+      end
+
+      # The base64 payload of an inline block. A reference has none to give,
+      # and an encoder that met one was handed content nobody resolved through
+      # {Blobs#inline}; sending the request without the image would answer a
+      # question about a picture the model never saw.
+      #
+      # @raise [Unresolved]
+      def data(block)
+        source = block.fetch("source")
+        return source.fetch("data") if source["type"] == BASE64
+
+        raise Unresolved, "an image #{source["type"].inspect} source reached an encoder unresolved"
+      end
+
+      # What a model is charged, which is pixels and not bytes: Anthropic bills
+      # an image at about `width * height / 750` tokens once its long edge is
+      # scaled to at most 1568px, so a 1280x800 screenshot costs ~1,366 tokens
+      # whether its PNG is 15KB or 290KB.
+      #
+      # @return [Integer]
+      def anthropic_tokens(width, height)
+        scale = [1.0, 1568.0 / [width, height].max].min
+        ((width * scale) * (height * scale) / 750).ceil
+      end
+
+      private
+
+      # `pack` answers US-ASCII, which {Tool::ResultBlock::Text} would re-tag by
+      # COPYING a quarter-megabyte String on every result; tagged UTF-8 here, it
+      # passes through by identity. `freeze`, not `-@`, which would intern a
+      # payload-sized String for the life of the process.
+      def base64(bytes) = [bytes].pack("m0").force_encoding(Encoding::UTF_8).freeze
+
+      def webp(raw) = (WEBP if raw.byteslice(0, 4) == "RIFF" && raw.byteslice(8, 4) == "WEBP")
+    end
+  end
+end
