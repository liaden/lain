diff --git a/spec/lain/image/blobs_spec.rb b/spec/lain/image/blobs_spec.rb
new file mode 100644
--- /dev/null
+++ b/spec/lain/image/blobs_spec.rb
@@ -0,0 +1,65 @@
+# frozen_string_literal: true
+
+require "tmpdir"
+
+RSpec.describe Lain::Image::Blobs do
+  around do |example|
+    Dir.mktmpdir("lain-blobs") do |root|
+      @root = root
+      example.run
+    end
+  end
+
+  let(:blobs) { described_class.new(root: @root) }
+  let(:png) { ImageFixtures.png }
+
+  it "stores bytes once under the BLAKE3 of the raw bytes" do
+    digest = blobs.put(png)
+
+    expect(digest).to eq("blake3:#{Lain::Ext.blake3_hex(png)}")
+    expect(blobs.put(png.dup)).to eq(digest)
+    expect(Dir.glob(File.join(@root, "**", "*")).count { |path| File.file?(path) }).to eq(1)
+  end
+
+  it "hands the same bytes back" do
+    expect(blobs.fetch(blobs.put(png))).to eq(png.b)
+  end
+
+  it "refuses a digest it holds no blob for" do
+    expect { blobs.fetch("blake3:#{"0" * 64}") }.to raise_error(described_class::Missing)
+  end
+
+  it "refuses bytes that no longer hash to their own name" do
+    digest = blobs.put(png)
+    File.binwrite(Dir.glob(File.join(@root, "*", "*")).first, "tampered")
+
+    expect { blobs.fetch(digest) }.to raise_error(described_class::Corrupt)
+  end
+
+  describe "#reference and #inline" do
+    # The whole trade: the Timeline holds a small reference, and what reaches
+    # the encoder is byte-identical to the block an inline tool would have
+    # built.
+    it "round-trips to the inline block, wherever the reference nests" do
+      reference = blobs.reference(png)
+      content = [{ "type" => "tool_result", "tool_use_id" => "c", "is_error" => false,
+                   "content" => [{ "type" => "text", "text" => "shot" }, reference] }]
+
+      resolved = blobs.inline(Lain::Canonical.normalize(content))
+
+      expect(resolved.first["content"].last).to eq(Lain::Image.block(png))
+    end
+
+    it "keeps the reference small whatever the image weighs" do
+      reference = blobs.reference(png * 1000)
+
+      expect(Lain::Canonical.dump(reference).bytesize).to be < 160
+    end
+
+    # The Merkle property survives: two different images give two different
+    # references, so two Events holding them hash apart.
+    it "names different bytes with different references" do
+      expect(Lain::Canonical.digest(blobs.reference(png))).not_to eq(Lain::Canonical.digest(blobs.reference("#{png}x")))
+    end
+  end
+end
