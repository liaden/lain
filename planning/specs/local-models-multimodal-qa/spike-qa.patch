diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/cli/epic_driver/qa_gate.rb qa-spike-main/lib/lain/cli/epic_driver/qa_gate.rb
--- a/lib/lain/cli/epic_driver/qa_gate.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/cli/epic_driver/qa_gate.rb	2026-09-22 09:29:24.124855055 -0400
@@ -0,0 +1,125 @@
+# frozen_string_literal: true
+
+module Lain
+  module CLI
+    module EpicDriver
+      # What the loop does when an {Epic::QaCheckpoint} becomes ready: run QA
+      # over the cluster that just landed, and either pass the checkpoint --
+      # which is what releases the next cluster -- or hold it and file every
+      # holding finding as an issue of its own.
+      #
+      # A FAILING PASS BLOCKS BY EDGES, NOT BY STATE. Each filed fix blocks the
+      # checkpoint, so the checkpoint is not ready again until every fix has
+      # landed, and whatever the checkpoint blocks stays blocked all that time
+      # with no flag anywhere saying so. The next run re-folds, finds the
+      # checkpoint ready, and runs QA again: the re-check is the fold's, not a
+      # retry this object remembers.
+      #
+      # Findings become ISSUES rather than annotations or a refused gate
+      # because a fix is work: it needs a plan, failing tests, an implementer
+      # and a landing, which is exactly what an issue already gets and nothing
+      # else in an epic does. `discovered_from` names the checkpoint, so the
+      # lineage says which pass found it.
+      class QaGate
+        PENDING = Lain::Epic::InFlight::PENDING
+
+        # What one pass came to, as the loop reports it.
+        Verdict = Data.define(:issue_id, :passed, :line) do
+          def initialize(issue_id:, passed:, line:) = super(issue_id: -issue_id.to_s, passed:, line: -line.to_s)
+        end
+
+        # No QA wired: a checkpoint holds its cluster, and says why. The loop's
+        # Null, for a bench or a spec that drives an epic with no QA -- in an
+        # epic QA is not optional, so this never passes anything.
+        module Unaudited
+          def self.call(issue, _graph)
+            Verdict.new(issue_id: issue.id, passed: false,
+                        line: "no QA is wired to this run, so the checkpoint holds everything it blocks")
+          end
+        end
+
+        # @param check [#call] `(checkpoint, graph) -> Qa::Report`
+        # @param scribe [#issue_moved] the epic's {Epic::Scribe}
+        # @param filing [#call] `issue ->` adds it to the epic's graph, written
+        #   and journaled ({CLI::Epic#file})
+        def initialize(check:, scribe:, filing:)
+          @check = check
+          @scribe = scribe
+          @filing = filing
+        end
+
+        # @param checkpoint [Epic::Issue] a ready {Epic::QaCheckpoint}
+        # @param graph [Epic::Graph] the fold it became ready in
+        # @return [Verdict]
+        def call(checkpoint, graph)
+          report = @check.call(checkpoint, graph)
+          report.passed? ? passed(checkpoint, report) : held(checkpoint, report, graph)
+        end
+
+        private
+
+        def passed(checkpoint, report)
+          @scribe.issue_moved(checkpoint.id, from: PENDING, to: Lain::Epic::DONE)
+          Verdict.new(issue_id: checkpoint.id, passed: true,
+                      line: "passed QA (#{report.findings.size} minor findings carried)")
+        end
+
+        def held(checkpoint, report, graph)
+          ids = Lain::Epic::QaCheckpoint.fix_ids(checkpoint.id, graph.ids)
+          filed = report.holding.zip(ids.first(report.holding.size)).map do |finding, id|
+            @filing.call(fix(checkpoint, finding, id))
+            id
+          end
+          Verdict.new(issue_id: checkpoint.id, passed: false,
+                      line: "QA held it: #{filed.size} holding findings filed as #{filed.join(", ")}, each " \
+                            "blocking this checkpoint -- plan and land them, and the next run checks again")
+        end
+
+        # One line per field, each opened with a bullet: the epic grammar reads
+        # a line opening `###`, a fence, or `Word: value` as structure, and a
+        # finding's evidence can hold any of the three.
+        def fix(checkpoint, finding, id)
+          Lain::Epic::Issue.new(id:, title: one_line("fix: #{finding.summary}")[0, 100].strip, blocks: [checkpoint.id],
+                                discovered_from: checkpoint.id, description: described(checkpoint, finding))
+        end
+
+        def described(checkpoint, finding)
+          fields = %w[criterion evidence reproduction].map do |field|
+            "- #{field} -- #{one_line(finding.public_send(field))}"
+          end
+          ["Found by QA at #{checkpoint.id} (#{finding.severity}, rung #{finding.tier}).", *fields].join("\n")
+        end
+
+        def one_line(text) = text.to_s.gsub(/\s+/, " ").strip
+
+        # What QA checks at a checkpoint: the acceptance criteria of every issue
+        # the checkpoint waits on, which is exactly the cluster that has just
+        # landed. An issue carries no risk, so each is the middle arm.
+        class ClusterQa
+          # @param ladder [#call] `-> Qa::Ladder`, built fresh per pass so each
+          #   pass has its own budget
+          def initialize(ladder:)
+            @ladder = ladder
+          end
+
+          # @return [Qa::Report]
+          def call(checkpoint, graph)
+            cluster = graph.blocked_by(checkpoint.id).map { |id| graph.fetch(id) }
+            climb = @ladder.call.call(cluster.flat_map { |issue| criteria(issue) })
+            Lain::Qa::Report.new(subject: "#{checkpoint.id} over #{cluster.map(&:id).join(", ")}",
+                                 findings: climb.findings, tiers_run: climb.tiers_run,
+                                 escalations: climb.escalations)
+          end
+
+          private
+
+          def criteria(issue)
+            Lain::Gherkin::Criteria.parse(issue.criteria.to_s).map do |scenario|
+              Lain::Qa::Ladder::Criterion.new(id: "#{issue.id}/#{scenario.name}", scenario:, risk: "medium")
+            end
+          end
+        end
+      end
+    end
+  end
+end
