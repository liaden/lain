+
+RSpec.describe Lain::Qa::Changeset, :seam do
+  around do |example|
+    Dir.mktmpdir("lain-qa-changeset") do |dir|
+      @repo = File.realpath(dir)
+      FileUtils.cp_r("#{SeedRepo.at({ "README" => "seed\n" })}/.", @repo)
+      example.run
+    end
+  end
+
+  def git(*) = Mixlib::ShellOut.new("git", "-C", @repo, *, environment: SeedRepo::SCRUB).run_command.tap(&:error!).stdout
+
+  it "reads the paths changed since the base, and quotes the range a finding reproduces with" do
+    base = git("rev-parse", "HEAD").strip
+    File.write(File.join(@repo, "order.rb"), "total\n")
+    git("add", "-A")
+    git("commit", "-q", "-m", "work")
+
+    changes = described_class.read(root: @repo, base:)
+
+    expect(changes.changed).to eq(["order.rb"])
+    expect(changes.range).to eq("#{base[0, 12]}..#{git("rev-parse", "HEAD").strip[0, 12]}")
+  end
+
+  it "refuses a base git cannot resolve, naming the command" do
+    expect { described_class.read(root: @repo, base: "no-such-ref") }
+      .to raise_error(Lain::Error, /could not read the changeset: `git rev-parse/)
+  end
