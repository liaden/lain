@@ -0,0 +1,9 @@
+## The tiers this project runs
+
+By default every rung runs on the session's own model, which makes the ladder a sampling and
+stopping discipline without a cost gradient. This hole is where a project names a model per rung
+and a budget per pass — the small tier for t1, a reviewer at least as strong as the implementer or
+of a different family for t2, a vision-capable model for t3 — and any standing rule such as "every
+card touching billing is high risk". Override it at `.lain/slots/skill/qa/tiers.md`. This text
+describes the assignment to the model reading it; the process that runs the ladder is what binds
+each rung to its model.
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa/answer.rb qa-spike-main/lib/lain/qa/answer.rb
--- a/lib/lain/qa/answer.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/answer.rb	2026-09-22 09:15:47.673179098 -0400
@@ -0,0 +1,65 @@
+# frozen_string_literal: true
+
+require "json"
+
+module Lain
+  module Qa
+    # One tier's answer about one criterion, read out of a child's reply.
+    #
+    # The child ends its reply with ONE fenced block tagged {FENCE} holding a
+    # JSON object. A reply with no such block, or one that does not parse, is
+    # not an error here: it reads as `unverified` with the reason in its
+    # evidence. A small model that cannot keep a format is a reason to climb
+    # the ladder, and crashing the pass over it would spend the whole run on
+    # the cheapest rung's weakness.
+    Answer = Data.define(:verdict, :confidence, :executed, :summary, :evidence, :reproduction) do
+      def self.parse(text)
+        body = text.to_s[Answer::PATTERN, 1]
+        return unreadable("the reply held no ```#{Answer::FENCE} block") if body.nil?
+
+        wire = JSON.parse(body)
+        return unreadable("the reply's block is not an object") unless wire.is_a?(Hash)
+
+        from_wire(wire)
+      rescue JSON::ParserError, ArgumentError, TypeError => e
+        unreadable("the reply's block did not read: #{e.message}")
+      end
+
+      def self.from_wire(wire)
+        new(verdict: wire.fetch("verdict", "unverified"), confidence: wire.fetch("confidence", 0.0),
+            executed: wire["executed"] == true, summary: wire["summary"].to_s,
+            evidence: wire["evidence"].to_s, reproduction: wire["reproduction"].to_s)
+      end
+
+      def self.unreadable(why)
+        new(verdict: "unverified", confidence: 0.0, executed: false, summary: why, evidence: why, reproduction: "")
+      end
+
+      def initialize(verdict:, confidence:, executed:, summary:, evidence:, reproduction:)
+        sample = Escalation::Sample.new(verdict:, confidence:, executed:)
+        super(verdict: sample.verdict, confidence: sample.confidence, executed: sample.executed,
+              summary: -summary.to_s, evidence: -evidence.to_s, reproduction: -reproduction.to_s)
+      end
+
+      def sample = Escalation::Sample.new(verdict:, confidence:, executed:)
+
+      # This answer as findings against +criterion+: one when it is a finding
+      # a person can check, none when it is not. A fail with no evidence or no
+      # way to reproduce it is exactly the weak-model false positive the ladder
+      # exists to keep from an implementer.
+      #
+      # @return [Array<Finding>]
+      def findings(criterion:, tier:, severity:)
+        [Finding.new(severity:, criterion:, tier:, summary: summary.empty? ? "fails: #{criterion}" : summary,
+                     evidence:, reproduction:)]
+      rescue MalformedFinding
+        []
+      end
+    end
+
+    class Answer
+      FENCE = "qa-answer"
+      PATTERN = /^```#{FENCE}[ \t]*\r?\n(.*?)^```[ \t]*$/m
+    end
+  end
+end
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa/changeset.rb qa-spike-main/lib/lain/qa/changeset.rb
--- a/lib/lain/qa/changeset.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/changeset.rb	2026-09-22 09:21:32.324207065 -0400
@@ -0,0 +1,39 @@
+# frozen_string_literal: true
+
+module Lain
+  module Qa
+    # The revisions a QA pass is about: a base the work started from, the head
+    # it reached, and the paths that differ between them. Read from git once,
+    # then a value, so every rung and every finding quotes the same range.
+    Changeset = Data.define(:base, :head, :changed) do
+      # @param root [String] the checkout to read
+      # @param base [String] any revision git resolves
+      # @param git [#run] an {Isolation::Checkout}; built over +root+ unless lent
+      # @return [Changeset]
+      # @raise [Lain::Error] when git cannot resolve either end or diff them
+      def self.read(root:, base:, git: Isolation::Checkout.new(root))
+        from = resolved(git, base)
+        to = resolved(git, "HEAD")
+        new(base: from, head: to, changed: git!(git, "diff", "--name-only", "-z", "--no-renames", from, to).split("\0"))
+      end
+
+      def self.resolved(git, revision) = git!(git, "rev-parse", "--verify", "--quiet", "#{revision}^{commit}").strip
+
+      def self.git!(git, *args)
+        shell = git.run(*args)
+        return shell.stdout if shell.exitstatus.zero?
+
+        raise Error, "QA could not read the changeset: `git #{args.join(" ")}` failed #{shell.stderr.to_s.strip}".strip
+      end
+      private_class_method :resolved, :git!
+
+      def initialize(base:, head:, changed:)
+        super(base: -base.to_s, head: -head.to_s, changed: changed.map { |path| -path.to_s }.freeze)
+      end
+
+      # The range every finding's reproduction quotes, in short SHAs a human
+      # can paste.
+      def range = "#{base[0, 12]}..#{head[0, 12]}"
+    end
+  end
+end
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa/claim_check.rb qa-spike-main/lib/lain/qa/claim_check.rb
--- a/lib/lain/qa/claim_check.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/claim_check.rb	2026-09-22 09:14:55.938772012 -0400
@@ -0,0 +1,61 @@
+# frozen_string_literal: true
+
+module Lain
+  module Qa
+    # The ladder's free rung: what the work CLAIMED against what the changeset
+    # PERFORMED, with no model asked.
+    #
+    # It runs first because it is the cheapest defect there is to find and the
+    # most expensive to find late. A card whose named spec file never appeared
+    # is a card whose acceptance criteria were never turned into anything that
+    # can fail; no model needs to read a line to know that.
+    #
+    # Pure over two lists. Where they came from -- a plan's `**Files:**`
+    # paragraphs, an implementer's hand-back, `git diff --name-only` -- is the
+    # caller's, and `range` is only quoted back so each finding carries the
+    # command that reproduces it.
+    class ClaimCheck
+      # @param claims [Hash{String=>Array<String>}] claimant (a card id) to the
+      #   paths it says it changed
+      # @param changed [Array<String>] the paths the changeset really touches
+      # @param range [String] the revision range `changed` was read over
+      def initialize(claims:, changed:, range:)
+        @claims = claims
+        @changed = changed.to_set
+        @range = range
+      end
+
+      # @return [Array<Finding>] unperformed claims first, then unclaimed work
+      def findings = unperformed + unclaimed
+
+      private
+
+      def unperformed
+        @claims.flat_map do |card, paths|
+          paths.reject { |path| @changed.include?(path) }.map { |path| unperformed_finding(card, path) }
+        end
+      end
+
+      # Scope creep is carried, never held on: a shared file an orchestrator
+      # wired is exactly this shape and is not a defect.
+      def unclaimed
+        claimed = @claims.values.flatten.to_set
+        @changed.reject { |path| claimed.include?(path) }.map { |path| unclaimed_finding(path) }
+      end
+
+      def unperformed_finding(card, path)
+        Finding.new(severity: "major", criterion: "#{card}/Files", tier: "t0",
+                    summary: "#{card} claims #{path}, and the changeset never touches it",
+                    evidence: "`git diff --name-only #{@range}` lists #{@changed.size} paths, not this one",
+                    reproduction: "git diff --name-only #{@range} -- #{path}   # prints nothing")
+      end
+
+      def unclaimed_finding(path)
+        Finding.new(severity: "minor", criterion: "plan/Files", tier: "t0",
+                    summary: "#{path} changed, and no card's Files names it",
+                    evidence: "`git diff --name-only #{@range}` lists it; no `**Files:**` paragraph does",
+                    reproduction: "git diff --stat #{@range} -- #{path}")
+      end
+    end
+  end
+end
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa/escalation.rb qa-spike-main/lib/lain/qa/escalation.rb
--- a/lib/lain/qa/escalation.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/escalation.rb	2026-09-22 09:14:32.202043677 -0400
@@ -0,0 +1,89 @@
+# frozen_string_literal: true
+
+module Lain
+  module Qa
+    # The rule that decides whether a cheap tier's verdict on ONE criterion is
+    # the answer, or whether a stronger tier has to look.
+    #
+    # Code rather than prose in the skill, because an escalation is spend, and a
+    # spend nobody can audit cannot be tuned: every {Decision} names the rule
+    # that fired, and the report carries it. The rules are ordered and the first
+    # to match wins, so each one reads as an exception to the ones below it.
+    #
+    # The tension this arbitrates is the user's: a weak model is cheap per call
+    # but a false positive it hands an implementer costs a whole fix round,
+    # while climbing on every doubt spends the strong model the ladder exists to
+    # save. So a CHEAP PASS stops only when it is unanimous and confident on a
+    # card that is not high risk, and a CHEAP FAIL stops only when it was
+    # observed by running something -- an exit status is not a model's opinion,
+    # so no stronger model is needed to believe it.
+    class Escalation
+      # One tier-1 sample of one criterion. `executed` is whether the sample's
+      # evidence is a command it ran and whose result it observed, rather than
+      # something it read and inferred.
+      Sample = Data.define(:verdict, :confidence, :executed) do
+        def initialize(verdict:, confidence:, executed: false)
+          verdict = verdict.to_s
+          raise ArgumentError, "verdict #{verdict.inspect} is not one of #{VERDICTS.join("/")}" unless
+            VERDICTS.include?(verdict)
+
+          super(verdict: -verdict, confidence: Float(confidence).clamp(0.0, 1.0), executed: executed ? true : false)
+        end
+
+        def executed_fail? = executed && verdict == "fail"
+      end
+
+      # `action` is what the ladder does next; `rule` is the name a report
+      # records, so the same decision reads the same way wherever it is audited.
+      Decision = Data.define(:action, :rule) do
+        def escalate? = action == :escalate
+
+        def to_s = "#{action} (#{rule})"
+      end
+
+      # The rules, in the order they are tried. Each is a name and a predicate
+      # over the samples and the card's risk.
+      RULES = [
+        [:report, "executed-fail", ->(samples, _risk) { samples.any?(&:executed_fail?) }],
+        [:escalate, "risk-high", ->(_samples, risk) { risk == "high" }],
+        [:escalate, "unverified", ->(samples, _risk) { samples.any? { |s| s.verdict == "unverified" } }],
+        [:escalate, "disagreement", ->(samples, _risk) { samples.map(&:verdict).uniq.size > 1 }],
+        [:escalate, "unconfirmed-fail", ->(samples, _risk) { samples.first.verdict == "fail" }]
+      ].freeze
+
+      # @param samples [Integer] how many tier-1 samples a criterion needs
+      #   before its agreement means anything; fewer is itself a reason to climb
+      # @param confidence [Float] the mean confidence below which a unanimous
+      #   pass is still not believed
+      def initialize(samples: 3, confidence: 0.7)
+        @samples = Integer(samples)
+        @confidence = Float(confidence)
+      end
+
+      # @param samples [Array<Sample>] every tier-1 sample of one criterion
+      # @param risk [String] the card's risk, one of {RISKS}
+      # @return [Decision]
+      def call(samples, risk:)
+        risk = known_risk(risk)
+        return Decision.new(action: :escalate, rule: "too-few-samples") if samples.size < @samples
+
+        action, rule, = RULES.find { |_action, _rule, applies| applies.call(samples, risk) }
+        return Decision.new(action:, rule:) unless rule.nil?
+
+        confident?(samples) ? Decision.new(action: :accept, rule: "unanimous-pass") : low_confidence
+      end
+
+      private
+
+      def confident?(samples) = samples.sum(&:confidence) / samples.size >= @confidence
+
+      def low_confidence = Decision.new(action: :escalate, rule: "low-confidence")
+
+      def known_risk(risk)
+        raise ArgumentError, "risk #{risk.inspect} is not one of #{RISKS.join("/")}" unless RISKS.include?(risk.to_s)
+
+        -risk.to_s
+      end
+    end
+  end
+end
