+++ b/lib/lain/cli/command/qa.rb	2026-09-22 09:29:02.355986053 -0400
@@ -0,0 +1,116 @@
+# frozen_string_literal: true
+
+require "fileutils"
+
+module Lain
+  module CLI
+    module Command
+      # `/qa PLAN --base REF` at `you>`: check a landed change against its
+      # plan's acceptance criteria and write the report the implementer fixes
+      # from. The optional step after `/execute-plan` on a large issue.
+      #
+      # The rungs are {::Lain::Qa}'s -- the structural check with no model,
+      # then {::Lain::Qa::Ladder} over the criteria -- and this command is the
+      # door onto them: it reads the plan and the changeset, binds each rung to
+      # a spawn, and says where the report went. It never touches the source
+      # tree; the one file it writes is the report, under {REPORTS}.
+      #
+      # Every `::Lain::Qa` below is root-qualified: this class is named for that
+      # namespace, and inside it a bare `Qa` is this class.
+      class Qa
+        USAGE = "/qa PLAN --base REF -- QA the change since REF against PLAN's acceptance criteria " \
+                "(reports, never fixes)"
+        FLAGS = %w[--base].freeze
+
+        # Under the project's own state directory, beside nothing it governs:
+        # a report is an artifact of one pass over one head, so it is named for
+        # the plan and the head it judged, and a re-run after fixes writes a
+        # second report rather than overwriting the evidence of the first.
+        REPORTS = File.join(".lain", "qa")
+
+        # Asks per rung for one pass. Sized so the cheap rung can sample twenty
+        # criteria three times while the strong one looks at one in five.
+        BUDGETS = { "t1" => 60, "t2" => 12, "t3" => 6 }.freeze
+
+        # @param root [String] the project root, where the plan and the report
+        #   paths resolve
+        # @param renderer [Skill::Renderer] renders the `qa` skill as the brief
+        # @param tiers [#call] `role_spawn -> {rung => #call}`, binding each
+        #   rung to the model it runs on
+        # @param budgets [Hash{String=>Integer}] asks per rung for the pass
+        # @param changeset [#call] `root:, base: -> Qa::Changeset`
+        def initialize(root:, renderer:, tiers: ::Lain::Qa::SessionTiers, budgets: BUDGETS,
+                       changeset: ::Lain::Qa::Changeset.method(:read))
+          @root = root
+          @renderer = renderer
+          @tiers = tiers
+          @budgets = budgets
+          @changeset = changeset
+        end
+
+        def name = "qa"
+
+        def usage = USAGE
+
+        # @param args [String] the line after the verb
+        # @param env [Env] the run's collaborators; its role spawn runs the rungs
+        # @return [String] the verdict, the counts, and where the report is
+        # @raise [Lain::Error] on a missing plan or base, or a changeset git
+        #   cannot read
+        def call(args, env)
+          plan, base = parsed(args)
+          changes = @changeset.call(root: @root, base:)
+          cards = ::Lain::Qa::PlanCards.read(File.read(plan))
+          report = judged(plan, changes, cards, env)
+          summary(report, written(plan, changes, report))
+        end
+
+        private
+
+        def judged(plan, changes, cards, env)
+          structural = ::Lain::Qa::ClaimCheck.new(claims: cards.claims, changed: changes.changed, range: changes.range)
+          climb = ladder(changes, env).call(cards.criteria)
+          ::Lain::Qa::Report.new(subject: "#{relative(plan)} @ #{changes.range}",
+                                 findings: structural.findings + climb.findings,
+                                 tiers_run: ["t0", *climb.tiers_run], escalations: climb.escalations)
+        end
+
+        def ladder(changes, env)
+          ::Lain::Qa::Ladder.new(tiers: @tiers.call(env.role_spawn), budgets: @budgets,
+                                 brief: "#{@renderer.render("qa")}\n\n## Under test\n\n`#{changes.range}`")
+        end
+
+        def written(plan, changes, report)
+          path = File.join(@root, REPORTS, "#{File.basename(plan, ".*")}-#{changes.head[0, 12]}.md")
+          FileUtils.mkdir_p(File.dirname(path))
+          File.write(path, report.to_markdown)
+          path
+        end
+
+        def summary(report, path)
+          verdict = report.passed? ? "PASS" : "HOLD"
+          "QA #{verdict}: #{report.findings.size} findings, #{report.holding.size} holding, " \
+            "rungs #{report.tiers_run.join("/")} -- report at #{relative(path)}"
+        end
+
+        def parsed(args)
+          parsed = Args.parse(args, name:, usage: USAGE, flags: FLAGS, positionals: 1)
+          plan = parsed.positionals.first
+          base = parsed.pairs["base"]
+          raise Error, "#{name} needs a plan doc and --base REF -- #{USAGE}" if plan.nil? || base.nil?
+
+          [readable(plan), base]
+        end
+
+        def readable(plan)
+          path = File.expand_path(plan, @root)
+          raise Error, "#{name} cannot read the plan at #{path}" unless File.file?(path)
+
+          path
+        end
+
+        def relative(path) = path.delete_prefix("#{@root}/")
+      end
+    end
+  end
+end
