--- a/spec/lain/qa/ladder_spec.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/spec/lain/qa/ladder_spec.rb	2026-09-22 09:32:39.031465186 -0400
@@ -0,0 +1,136 @@
+# frozen_string_literal: true
+
+# A tier that answers from a script, cycling one reply per ask, and counts its asks --
+# which is what makes "the cheap rung stopped it" observable as spend.
+class LadderSpecTier
+  def initialize(*replies)
+    @replies = replies
+    @prompts = []
+  end
+
+  attr_reader :prompts
+
+  def call(prompt)
+    @prompts << prompt
+    "```qa-answer\n#{JSON.generate(@replies[(@prompts.size - 1) % @replies.size])}\n```\n"
+  end
+end
+
+RSpec.describe Lain::Qa::Ladder do
+  let(:pass) { { "verdict" => "pass", "confidence" => 0.9 } }
+  let(:inferred_fail) do
+    { "verdict" => "fail", "confidence" => 0.9, "evidence" => "reads wrong", "reproduction" => "" }
+  end
+  let(:confirmed_fail) do
+    { "verdict" => "fail", "confidence" => 0.9, "summary" => "total off by one",
+      "evidence" => "bin/total printed 2", "reproduction" => "bin/total" }
+  end
+
+  def criterion(name = "totals", risk: "medium")
+    scenario = Lain::Gherkin::Scenario.new(name:, clauses: [Lain::Gherkin::Clause.new(keyword: "Then", text: "ok")])
+    described_class::Criterion.new(id: "T1/#{name}", scenario:, risk:)
+  end
+
+  def climb(tiers, *criteria, budgets: {}) = described_class.new(tiers:, brief: "QA brief", budgets:).call(criteria)
+
+  it "stops at the cheap rung when its samples agree, spending nothing above it" do
+    t1 = LadderSpecTier.new(pass)
+    t2 = LadderSpecTier.new(pass)
+
+    climb = climb({ "t1" => t1, "t2" => t2 }, criterion)
+
+    expect(climb.findings).to be_empty
+    expect([t1.prompts.size, t2.prompts.size]).to eq([3, 0])
+    expect(climb.escalations).to eq(["T1/totals: t1 accept (unanimous-pass)"])
+  end
+
+  it "climbs on disagreement and reports the stronger rung's finding as that rung's" do
+    t1 = LadderSpecTier.new(pass, inferred_fail, pass)
+    t2 = LadderSpecTier.new(confirmed_fail)
+
+    climb = climb({ "t1" => t1, "t2" => t2 }, criterion)
+
+    expect(climb.findings.map { |f| [f.tier, f.severity, f.reproduction] }).to eq([%w[t2 major bin/total]])
+    expect(climb.escalations).to eq(["T1/totals: t1 escalate (disagreement)"])
+    expect(climb.tiers_run).to eq(%w[t1 t2])
+  end
+
+  # The weak-model false positive: the cheap rung is unanimous that it fails,
+  # but only inferred it, and the stronger rung finds it passes.
+  it "keeps an unconfirmed cheap fail away from the implementer when the stronger rung disagrees" do
+    climb = climb({ "t1" => LadderSpecTier.new(inferred_fail), "t2" => LadderSpecTier.new(pass) }, criterion)
+
+    expect(climb.findings).to be_empty
+    expect(climb.escalations.first).to end_with("(unconfirmed-fail)")
+  end
+
+  it "takes an executed cheap fail as the finding without asking the stronger rung" do
+    executed = confirmed_fail.merge("executed" => true)
+    t2 = LadderSpecTier.new(pass)
+
+    climb = climb({ "t1" => LadderSpecTier.new(pass, executed, pass), "t2" => t2 }, criterion(risk: "high"))
+
+    expect(climb.findings.map { |f| [f.tier, f.severity] }).to eq([%w[t1 blocker]])
+    expect(t2.prompts).to be_empty
+  end
+
+  describe "the stopping rules" do
+    # "Nobody could tell" is the manual pass owed; omitting it would read as a
+    # pass.
+    it "carries a criterion no rung could settle as a minor finding, never as a pass" do
+      climb = climb({ "t1" => LadderSpecTier.new(pass, inferred_fail, pass) }, criterion)
+
+      found = climb.findings.map { |f| [f.severity, f.summary] }
+
+      expect(found).to eq([["minor", "unsettled -- a manual pass is owed"]])
+    end
+
+    it "stops asking a rung once its budget is spent, and says so on the finding" do
+      t2 = LadderSpecTier.new(pass)
+      tiers = { "t1" => LadderSpecTier.new(pass, inferred_fail, pass), "t2" => t2 }
+
+      climb = climb(tiers, criterion("a"), criterion("b"), budgets: { "t2" => 1 })
+
+      expect(t2.prompts.size).to eq(1)
+      expect(climb.findings.map(&:criterion)).to eq(["T1/b"])
+    end
+  end
+
+  describe "visual criteria" do
+    it "skips the text rungs and asks the media rung" do
+      t1 = LadderSpecTier.new(pass)
+      t3 = LadderSpecTier.new(confirmed_fail)
+
+      climb = climb({ "t1" => t1, "t3" => t3 }, criterion("[visual] the status line shows the model"))
+
+      expect(t1.prompts).to be_empty
+      expect(climb.findings.map(&:tier)).to eq(["t3"])
+    end
+
+    it "owes a manual pass when no media rung is wired" do
+      climb = climb({ "t1" => LadderSpecTier.new(pass) }, criterion("[visual] the pane is green"))
+
+      expect(climb.findings.map { |f| [f.tier, f.evidence] }).to eq([["t3", "no media tier could look at it"]])
+    end
+  end
+
+  # One GPU holds one large model at a time, so a per-criterion climb would
+  # pay a model swap twice per escalation.
+  it "takes every criterion's cheap samples before any stronger ask" do
+    order = []
+    fence = ->(reply) { "```qa-answer\n#{JSON.generate(reply)}\n```" }
+    t1 = ->(_prompt) { (order << "t1") && fence.call(order.size.odd? ? pass : inferred_fail) }
+    t2 = ->(_prompt) { (order << "t2") && fence.call(pass) }
+
+    climb({ "t1" => t1, "t2" => t2 }, criterion("a"), criterion("b"))
+
+    expect(order).to eq(%w[t1 t1 t1 t1 t1 t1 t2 t2])
+  end
+
+  it "opens every prompt with the brief and names the rung and the criterion" do
+    t1 = LadderSpecTier.new(pass)
+    climb({ "t1" => t1 }, criterion)
+
+    expect(t1.prompts.first).to start_with("QA brief").and include("## Rung t1: criterion T1/totals (risk: medium)")
+  end
+end
