--- a/lib/lain/epic/qa_checkpoint.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/epic/qa_checkpoint.rb	2026-09-22 09:23:59.336504529 -0400
@@ -0,0 +1,42 @@
+# frozen_string_literal: true
+
+module Lain
+  module Epic
+    # A QA checkpoint: an issue in the blocking graph whose work is QA itself.
+    #
+    # It needs no new concept because the graph already says everything a
+    # checkpoint means. Blocked by a cluster's issues, it becomes ready exactly
+    # when the cluster has landed; blocking the next cluster, it holds that
+    # cluster until QA passes; blocked by every leaf, it is the epic's final
+    # pass. A failing pass files each holding finding as a new issue that
+    # BLOCKS the checkpoint, so the checkpoint runs again once the fixes land
+    # -- and the next cluster stays held the whole time, by the edges alone.
+    #
+    # Marked by its id, because an id is the one thing the epic markdown, the
+    # issue's filename and the digest already carry: a new {Issue} member would
+    # move the digest of every issue in every existing epic, and a new
+    # {STAGES} member cannot sit BETWEEN two clusters of one stage.
+    module QaCheckpoint
+      PREFIX = "qa-gate-"
+
+      # The fix issues a checkpoint files open with this, which does NOT open
+      # with {PREFIX}: a fix read as a checkpoint would be run as QA instead of
+      # being implemented.
+      FIX_PREFIX = "qa-fix-"
+
+      # @param issue [Issue]
+      def self.of?(issue) = issue.id.start_with?(PREFIX)
+
+      # The first fix id past every one +taken+ already holds, so a second
+      # failing pass files beside the first rather than colliding with it.
+      #
+      # @param checkpoint_id [String] a checkpoint's id
+      # @param taken [Array<String>] every id the graph holds
+      # @return [Enumerator<String>] fresh ids, in order
+      def self.fix_ids(checkpoint_id, taken)
+        stem = "#{FIX_PREFIX}#{checkpoint_id.delete_prefix(PREFIX)}-"
+        (1..).lazy.map { |n| "#{stem}#{n}" }.reject { |id| taken.include?(id) }
+      end
+    end
+  end
+end
