--- a/lib/lain/qa/finding.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/finding.rb	2026-09-22 09:31:21.896022081 -0400
@@ -0,0 +1,61 @@
+# frozen_string_literal: true
+
+module Lain
+  module Qa
+    # One defect QA observed, in a shape somebody else can check.
+    #
+    # FALSIFIABLE OR REFUSED. A finding with no evidence or no reproduction is
+    # an opinion, and an implementer handed an opinion spends a round arguing
+    # with it; so both are required and blank is refused at construction, the
+    # way {Epic::Issue} refuses criteria that parse to nothing. `evidence` is
+    # what was observed (command output, `file:line`, a screenshot reference);
+    # `reproduction` is how to observe it again.
+    #
+    # `criterion` names what the finding is measured against: an acceptance
+    # criterion, or a card's claim (`<card>/Files`) for the structural rung.
+    Finding = Data.define(:severity, :criterion, :summary, :evidence, :reproduction, :tier) do
+      def initialize(severity:, criterion:, summary:, evidence:, reproduction:, tier:)
+        super(severity: member!(severity, SEVERITIES, "severity"), criterion: text!(criterion, "criterion"),
+              summary: text!(summary, "summary"), evidence: text!(evidence, "evidence"),
+              reproduction: text!(reproduction, "reproduction"), tier: member!(tier, TIERS, "tier"))
+      end
+
+      # The wire form the QA child emits and the report file stores.
+      #
+      # @param hash [Hash] String or Symbol keys
+      # @return [Finding]
+      # @raise [MalformedFinding] naming the member that is missing or wrong
+      def self.from_h(hash)
+        raise MalformedFinding, "a finding must be an object, got #{hash.inspect}" unless hash.is_a?(Hash)
+
+        keyed = hash.transform_keys(&:to_sym)
+        missing = members - keyed.keys
+        raise MalformedFinding, "a finding names no #{missing.join(", ")}" unless missing.empty?
+
+        new(**keyed.slice(*members))
+      end
+
+      # Whether this finding stops the work it is about from going further.
+      def holds? = HOLDING.include?(severity)
+
+      def to_h = super.transform_keys(&:to_s)
+
+      private
+
+      def member!(value, set, field)
+        value = value.to_s
+        raise MalformedFinding, "#{field} #{value.inspect} is not one of #{set.join("/")}" unless set.include?(value)
+
+        -value
+      end
+
+      def text!(value, field)
+        value = value.to_s.strip
+        raise MalformedFinding, "a finding's #{field} cannot be blank: a finding nobody can check is an opinion" if
+          value.empty?
+
+        -value
+      end
+    end
+  end
+end
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa/ladder.rb qa-spike-main/lib/lain/qa/ladder.rb
--- a/lib/lain/qa/ladder.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/ladder.rb	2026-09-22 09:32:21.131673544 -0400
@@ -0,0 +1,160 @@
+# frozen_string_literal: true
+
+module Lain
+  module Qa
+    # The model rungs of the QA ladder, driven by lain rather than by a model:
+    # which tier looks at which criterion, how many times, and when to stop.
+    #
+    # Lain owns this loop for the reason it owns the agent loop -- the loop is
+    # the thing under study. Which rung found a defect, what each escalation
+    # cost, and which rule sent it there are all a bench wants to compare
+    # across tier assignments, and a QA child choosing its own escalations
+    # would leave none of it on the record.
+    #
+    # A tier is anything answering `call(prompt) -> String`: the QA role bound
+    # to that tier's provider and model ({Skill::RoleSpawn#tiered}). A tier the
+    # ladder was not given is a rung it cannot climb to, and every criterion
+    # that needed it is reported unsettled rather than silently passed.
+    class Ladder
+      # A scenario whose name opens with this is judged by looking at it. A
+      # name prefix because the Gherkin grammar is closed and a name is free
+      # text; the grammar's own `# rubric` marker is where this belongs once it
+      # grows a second value.
+      VISUAL = "[visual]"
+
+      # What tier 1 answers for a criterion it leaves to tier 2.
+      CLIMB = :climb
+
+      Criterion = Data.define(:id, :scenario, :risk)
+
+      # One criterion to check: `id` is what a finding cites
+      # (`<card>/<scenario name>`), `risk` the card's. Reopened so {VISUAL} is
+      # read from the Ladder rather than declared inside the Data block.
+      class Criterion
+        def visual? = scenario.name.start_with?(VISUAL)
+      end
+
+      # What the ladder came to, for {Report} to carry.
+      Climb = Data.define(:findings, :escalations, :tiers_run)
+
+      # @param tiers [Hash{String=>#call}] rung name to the tier asked there
+      # @param brief [String] what every prompt opens with -- the rendered
+      #   `qa` skill and the changeset under test
+      # @param budgets [Hash{String=>Integer}] how many asks each rung may spend
+      #   across the whole pass; a rung absent here is unbounded
+      # @param escalation [Escalation] the rule over tier-1's samples
+      # @param samples [Integer] tier-1 asks per criterion
+      def initialize(tiers:, brief:, budgets: {}, escalation: Escalation.new(samples: 3), samples: 3)
+        @tiers = tiers
+        @brief = brief
+        @left = budgets.dup
+        @escalation = escalation
+        @samples = samples
+        @escalations = []
+        @asked = []
+      end
+
+      # BREADTH-FIRST BY RUNG. Every criterion's tier-1 samples are taken
+      # before any tier-2 ask, and the media rung goes last: on one GPU that
+      # holds one large model at a time, a swap costs the better part of a
+      # minute and a per-criterion climb would pay it twice per escalation.
+      # Taken rung by rung, a pass pays it once per rung.
+      #
+      # @param criteria [Array<Criterion>]
+      # @return [Climb]
+      def call(criteria)
+        visual, text = criteria.partition(&:visual?)
+        first = text.map { |criterion| [criterion, first_rung(criterion)] }
+        climbing = first.select { |_criterion, found| found == CLIMB }.map(&:first)
+        settled = first.flat_map { |_criterion, found| found == CLIMB ? [] : found }
+        findings = settled + climbing.flat_map { |criterion| escalated(criterion) } + visual.flat_map { |c| looked(c) }
+        Climb.new(findings:, escalations: @escalations.dup, tiers_run: TIERS & @asked)
+      end
+
+      private
+
+      # Visual criteria skip the text rungs: a text model asked whether a pane
+      # renders correctly can only guess, and a guess is what the ladder is
+      # built to keep off the record.
+      def looked(criterion)
+        return unsettled(criterion, "t3", "no media tier could look at it") unless open?("t3")
+
+        judged(ask("t3", criterion), criterion, "t3")
+      end
+
+      # What tier 1 settled on its own, or {CLIMB} for the tier-2 pass. A
+      # reported fail that will not stand as a finding climbs too.
+      def first_rung(criterion)
+        decision = t1_decision(criterion)
+        @escalations << "#{criterion.id}: t1 #{decision}"
+        case decision.action
+        when :accept then []
+        when :report then reported(decision.samples, criterion)
+        else CLIMB
+        end
+      end
+
+      # The samples ride on the decision so {#reported} can find the one whose
+      # execution is the evidence.
+      Judged = Data.define(:action, :rule, :samples) do
+        def to_s = "#{action} (#{rule})"
+      end
+      private_constant :Judged
+
+      def t1_decision(criterion)
+        return Judged.new(action: :escalate, rule: "t1-unavailable", samples: []) unless open?("t1", @samples)
+
+        answers = Array.new(@samples) { ask("t1", criterion) }
+        decision = @escalation.call(answers.map(&:sample), risk: criterion.risk)
+        Judged.new(action: decision.action, rule: decision.rule, samples: answers)
+      end
+
+      # The executed failure is the evidence; if it will not stand as a finding
+      # after all, the stronger rung decides.
+      def reported(answers, criterion)
+        executed = answers.find { |answer| answer.sample.executed_fail? }
+        found = executed.findings(criterion: criterion.id, tier: "t1", severity: severity(criterion))
+        found.empty? ? CLIMB : found
+      end
+
+      def escalated(criterion)
+        return unsettled(criterion, "t2", "t1 could not settle it, and t2 is absent or spent") unless open?("t2")
+
+        judged(ask("t2", criterion), criterion, "t2")
+      end
+
+      def judged(answer, criterion, tier)
+        return [] if answer.verdict == "pass"
+
+        found = []
+        found = answer.findings(criterion: criterion.id, tier:, severity: severity(criterion)) if
+          answer.verdict == "fail"
+        found.empty? ? unsettled(criterion, tier, "#{tier} said #{answer.verdict}: #{answer.evidence}") : found
+      end
+
+      # A criterion the ladder could not settle is carried as a minor finding
+      # rather than dropped: "nobody could tell" is the manual pass owed, and a
+      # report that omitted it would read as a pass.
+      def unsettled(criterion, tier, why)
+        [Finding.new(severity: "minor", criterion: criterion.id, tier:, summary: "unsettled -- a manual pass is owed",
+                     evidence: why, reproduction: criterion.scenario.render)]
+      end
+
+      def severity(criterion) = criterion.risk == "high" ? "blocker" : "major"
+
+      # Whether +tier+ is wired and can still afford +asks+ more.
+      def open?(tier, asks = 1) = @tiers.key?(tier) && (!@left.key?(tier) || @left.fetch(tier) >= asks)
+
+      def ask(tier, criterion)
+        @asked << tier
+        @left[tier] -= 1 if @left.key?(tier)
+        Answer.parse(@tiers.fetch(tier).call(prompt(tier, criterion)))
+      end
+
+      def prompt(tier, criterion)
+        "#{@brief}\n\n## Rung #{tier}: criterion #{criterion.id} (risk: #{criterion.risk})\n\n" \
+          "```gherkin\n#{criterion.scenario.render}\n```\n"
+      end
+    end
+  end
+end
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa/plan_cards.rb qa-spike-main/lib/lain/qa/plan_cards.rb
--- a/lib/lain/qa/plan_cards.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/plan_cards.rb	2026-09-22 09:29:46.219475993 -0400
@@ -0,0 +1,62 @@
+# frozen_string_literal: true
+
+module Lain
+  module Qa
+    # A `/create-plan` doc read for what QA holds it to: each card's claimed
+    # files, its risk, and its acceptance criteria.
+    #
+    # Read by the grammar the shipped create-plan scaffold asks for -- a card
+    # headed `### T<id> ... [risk: <level>]`, its paths backticked on a
+    # `**Files:**` paragraph that runs to the next blank line, its criteria in
+    # ```gherkin fences -- and no further. A card that states a part some other
+    # way yields nothing for that part, which the checks downstream report as
+    # a card with nothing to hold it to rather than guessing.
+    class PlanCards
+      include Enumerable
+
+      CARD = /^###\s+(T[\w.-]+)\b/
+      RISK = /\[risk:\s*(\w+)\]/
+      FILES = /^\*\*Files:\*\*(.*?)(?=^\s*$|^\*\*\w|\z)/m
+      PATH = /`([^`\s]+)`/
+
+      # One card. `risk` is `medium` when the heading names none: the middle
+      # arm neither waves a criterion through nor spends t2 on every one.
+      Card = Data.define(:id, :risk, :files, :criteria)
+
+      # @param markdown [String] the plan doc
+      # @return [PlanCards]
+      # @raise [Gherkin::MalformedBlock] for a card whose criteria do not parse
+      def self.read(markdown)
+        new(markdown.to_s.split(/(?=^###\s)/).filter_map { |section| card(section) })
+      end
+
+      def self.card(section)
+        id = section[CARD, 1]
+        return if id.nil?
+
+        risk = section[RISK, 1]
+        Card.new(id: -id, risk: RISKS.include?(risk) ? -risk : "medium", files: paths(section),
+                 criteria: Gherkin::Criteria.parse(section))
+      end
+
+      def self.paths(section) = section[FILES, 1].to_s.scan(PATH).flatten.map(&:-@).uniq.freeze
+      private_class_method :card, :paths
+
+      def initialize(cards) = @cards = cards.freeze
+
+      def each(&block) = @cards.each(&block)
+
+      # @return [Hash{String=>Array<String>}] card id to the paths it claims,
+      #   every card present even when it claims nothing -- {ClaimCheck}'s input
+      def claims = to_h { |card| [card.id, card.files] }
+
+      # @return [Array<Ladder::Criterion>] every scenario of every card, cited
+      #   as `<card>/<scenario name>` and carrying its card's risk
+      def criteria
+        flat_map do |card|
+          card.criteria.map { |scenario| Ladder::Criterion.new(id: "#{card.id}/#{scenario.name}", scenario:, risk: card.risk) }
+        end
+      end
+    end
+  end
+end
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa/report.rb qa-spike-main/lib/lain/qa/report.rb
--- a/lib/lain/qa/report.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/report.rb	2026-09-22 09:13:57.699438104 -0400
@@ -0,0 +1,82 @@
+# frozen_string_literal: true
+
+require "json"
+
+module Lain
+  module Qa
+    # What one QA pass came to: the findings, which rungs of the ladder ran,
+    # and every escalation it took with the rule that fired -- so a reader can
+    # see what the pass spent and why, not only what it found.
+    #
+    # The QA child answers in prose and ends with ONE fenced block tagged
+    # {FENCE} holding this value as JSON. Only the fence is read: prose around
+    # it is for the human, and a child whose answer has no fence produced no
+    # report, which is refused rather than read as a clean pass.
+    Report = Data.define(:subject, :findings, :tiers_run, :escalations) do
+      def initialize(subject:, findings: [], tiers_run: [], escalations: [])
+        super(subject: -subject.to_s, findings: findings.dup.freeze,
+              tiers_run: tiers_run.map { |tier| -tier.to_s }.freeze,
+              escalations: escalations.map { |line| -line.to_s }.freeze)
+      end
+
+      # @param text [String] the QA child's whole answer
+      # @param subject [String] what was checked, stamped by the caller
+      # @return [Report]
+      # @raise [MalformedReport] when the answer holds no report fence, or the
+      #   fence is not a report
+      def self.parse(text, subject:)
+        body = text.to_s[Report::PATTERN, 1]
+        raise MalformedReport, "the QA answer holds no ```#{Report::FENCE} block, so it reported nothing" if body.nil?
+
+        wire = JSON.parse(body)
+        new(subject:, findings: Array(wire["findings"]).map { |finding| Finding.from_h(finding) },
+            tiers_run: Array(wire["tiers_run"]), escalations: Array(wire["escalations"]))
+      rescue JSON::ParserError => e
+        raise MalformedReport, "the QA answer's report block is not JSON: #{e.message}"
+      end
+
+      # Nothing found holds the work back. Minor findings do not.
+      def passed? = findings.none?(&:holds?)
+
+      def holding = findings.select(&:holds?)
+
+      # This report with +others+ found before it -- the structural rung's
+      # findings, which run in-process ahead of any model.
+      def prepend(others) = with(findings: others + findings, tiers_run: (["t0"] + tiers_run).uniq)
+
+      # @return [String] the report file a human and the implementer read
+      def to_markdown
+        [header, *escalation_lines, "", *findings.each_with_index.map { |finding, index| entry(finding, index) }]
+          .join("\n")
+      end
+
+      private
+
+      def header
+        verdict = passed? ? "PASS" : "HOLD (#{holding.size} holding)"
+        "# QA report: #{subject}\n\nVerdict: #{verdict}. Tiers run: #{tiers_run.join(", ")}. " \
+          "Findings: #{findings.size}."
+      end
+
+      def escalation_lines
+        escalations.empty? ? [] : ["", "## Escalations", *escalations.map { |line| "- #{line}" }]
+      end
+
+      def entry(finding, index)
+        <<~ENTRY
+          ## #{index + 1}. [#{finding.severity}] #{finding.summary}
+
+          - criterion: #{finding.criterion}
+          - found at: #{finding.tier}
+          - evidence: #{finding.evidence}
+          - reproduce: #{finding.reproduction}
+        ENTRY
+      end
+    end
+
+    class Report
+      FENCE = "qa-report"
+      PATTERN = /^```#{FENCE}[ \t]*\r?\n(.*?)^```[ \t]*$/m
+    end
+  end
+end
