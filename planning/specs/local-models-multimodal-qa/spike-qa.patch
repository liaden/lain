--- a/lib/lain/qa/session_tiers.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa/session_tiers.rb	2026-09-22 09:25:42.323309884 -0400
@@ -0,0 +1,18 @@
+# frozen_string_literal: true
+
+module Lain
+  module Qa
+    # Every text rung on the session's own model, and no media rung: the
+    # ladder's sampling and stopping discipline without its cost gradient,
+    # which is what a pass gets until a project binds its tiers. Each rung is
+    # the `qa` role on a fresh context, so no rung sees another's reasoning.
+    module SessionTiers
+      # @param role_spawn [Skill::RoleSpawn] the spawn every rung runs through
+      # @return [Hash{String=>#call}] rung name to `prompt -> reply`
+      def self.call(role_spawn)
+        ask = ->(prompt) { role_spawn.call(:qa, :fresh, prompt).content }
+        { "t1" => ask, "t2" => ask }
+      end
+    end
+  end
+end
diff -ruN '--exclude=lain.so' '--exclude=.lain' '--exclude=.rspec_status' '--exclude=tmp' '--exclude=log' qa-spike-pristine/lib/lain/qa.rb qa-spike-main/lib/lain/qa.rb
--- a/lib/lain/qa.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/lib/lain/qa.rb	2026-09-22 09:13:29.335761928 -0400
@@ -0,0 +1,34 @@
+# frozen_string_literal: true
+
+module Lain
+  # Quality assurance over work that has already landed: a role that runs the
+  # change and REPORTS, never fixes, climbing a ladder of model tiers from the
+  # free checks to the expensive ones only as far as the evidence demands.
+  #
+  # The closed vocabularies live here, in the namespace file, because
+  # {Qa::Finding} and {Qa::Escalation} both cite them in their class bodies.
+  module Qa
+    # A finding at one of the first two holds the gate; `minor` is carried in
+    # the report and holds nothing. Closed because the gate's whole rule is
+    # "does any finding hold", and a fourth spelling would silently hold
+    # nothing.
+    SEVERITIES = %w[blocker major minor].freeze
+    HOLDING = %w[blocker major].freeze
+
+    # The ladder's rungs, cheapest first. `t0` spends no model at all; `t3` is
+    # the media rung, reached only for a criterion that is visual.
+    TIERS = %w[t0 t1 t2 t3].freeze
+
+    # What one sample of one criterion may say. `unverified` is not a pass: it
+    # is a tier admitting it could not settle the criterion, which is a reason
+    # to climb rather than a verdict to average.
+    VERDICTS = %w[pass fail unverified].freeze
+
+    # The card risks `/create-plan` assigns, which the ladder reads to decide
+    # how far a cheap verdict may be trusted.
+    RISKS = %w[low medium high].freeze
+
+    class MalformedFinding < Error; end
+    class MalformedReport < Error; end
+  end
+end
