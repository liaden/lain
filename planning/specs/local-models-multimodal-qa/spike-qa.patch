+++ b/spec/lain/qa/escalation_spec.rb	2026-09-22 09:17:26.073048595 -0400
@@ -0,0 +1,63 @@
+# frozen_string_literal: true
+
+RSpec.describe Lain::Qa::Escalation do
+  subject(:escalation) { described_class.new(samples: 3, confidence: 0.7) }
+
+  def sample(verdict, confidence = 0.9, executed: false)
+    described_class::Sample.new(verdict:, confidence:, executed:)
+  end
+
+  def decide(samples, risk: "medium") = escalation.call(samples, risk:)
+
+  describe "when a cheap pass is the answer" do
+    it "accepts a unanimous, confident pass on a card that is not high risk" do
+      expect(decide([sample("pass")] * 3)).to have_attributes(action: :accept, rule: "unanimous-pass")
+    end
+
+    it "does not believe a unanimous pass whose confidence is low" do
+      expect(decide([sample("pass", 0.4)] * 3)).to have_attributes(action: :escalate, rule: "low-confidence")
+    end
+
+    it "sends every high-risk criterion up, however unanimous" do
+      expect(decide([sample("pass")] * 3, risk: "high")).to have_attributes(action: :escalate, rule: "risk-high")
+    end
+  end
+
+  describe "when a cheap fail is the answer" do
+    # An exit status is not a model's opinion: no stronger model is needed to
+    # believe it, even on a high-risk card.
+    it "reports a failure observed by running something, even at high risk" do
+      samples = [sample("pass"), sample("fail", 0.5, executed: true), sample("pass")]
+
+      expect(decide(samples, risk: "high")).to have_attributes(action: :report, rule: "executed-fail")
+    end
+
+    # A weak model's false positive costs an implementer a fix round, so a
+    # fail it only inferred is confirmed before anyone is handed it.
+    it "escalates a unanimous fail that was only inferred" do
+      expect(decide([sample("fail")] * 3)).to have_attributes(action: :escalate, rule: "unconfirmed-fail")
+    end
+  end
+
+  describe "when the cheap tier cannot settle it" do
+    it "escalates on disagreement" do
+      expect(decide([sample("pass"), sample("fail"), sample("pass")])).to have_attributes(rule: "disagreement")
+    end
+
+    it "escalates when any sample could not verify the criterion" do
+      expect(decide([sample("pass"), sample("unverified"), sample("pass")])).to have_attributes(rule: "unverified")
+    end
+
+    it "escalates when fewer samples came back than agreement needs" do
+      expect(decide([sample("pass")] * 2)).to have_attributes(action: :escalate, rule: "too-few-samples")
+    end
+  end
+
+  it "refuses a risk the plan grammar does not assign" do
+    expect { decide([sample("pass")] * 3, risk: "spicy") }.to raise_error(ArgumentError, %r{low/medium/high})
+  end
+
+  it "records a decision as the action and the rule that fired" do
+    expect(decide([sample("fail")] * 3).to_s).to eq("escalate (unconfirmed-fail)")
+  end
+end
