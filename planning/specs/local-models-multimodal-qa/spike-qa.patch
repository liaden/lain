--- a/spec/lain/cli/command/qa_spec.rb	1969-12-31 19:00:00.000000000 -0500
+++ b/spec/lain/cli/command/qa_spec.rb	2026-09-22 09:25:54.739165769 -0400
@@ -0,0 +1,103 @@
+# frozen_string_literal: true
+
+require "tmpdir"
+
+# The `qa` skill, rendered: the command only ever quotes it as the brief.
+class QaCommandSpecRenderer
+  def render(name) = "BRIEF(#{name})"
+end
+
+# `/qa PLAN --base REF`: the door onto the QA ladder. What these examples pin is
+# the door -- what it reads, which rungs it binds, what it writes and where --
+# over a changeset and tiers that are both doubled, so no git and no model runs.
+RSpec.describe Lain::CLI::Command::Qa do
+  around do |example|
+    Dir.mktmpdir("lain-qa-command") do |root|
+      @root = root
+      FileUtils.mkdir_p(File.join(root, "planning/specs"))
+      File.write(File.join(root, "planning/specs/totals.md"), plan)
+      example.run
+    end
+  end
+
+  let(:plan) do
+    <<~MD
+      ### T1 — Add the order total          [wave 1] [risk: low]
+
+      **Files:** `lib/order.rb` (create), `spec/order_spec.rb` (create)
+
+      ```gherkin
+      Scenario: the total sums the lines
+        Given an order of two lines
+        Then its total is their sum
+      ```
+    MD
+  end
+
+  let(:head) { "b" * 40 }
+  let(:asked) { [] }
+
+  def changes(*changed) = Lain::Qa::Changeset.new(base: "a" * 40, head:, changed:)
+
+  def reply(verdict) = "```qa-answer\n#{JSON.generate("verdict" => verdict, "confidence" => 0.9)}\n```\n"
+
+  def command(changed: %w[lib/order.rb spec/order_spec.rb], verdict: "pass")
+    tier = lambda do |prompt|
+      asked << prompt
+      reply(verdict)
+    end
