#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "lain"
require "open3"
require "pathname"
require "rbconfig"
require "tmpdir"

# Guards the chat-turn, bash-call, request and journal paths the way `bin/runtime-census` guards the
# suite's wall: `--record` keeps the last 3 logs, `--check` exits 1 when a row is over its ceiling in
# 2 of them.
#
#   --record   measure every row and keep the log under tmp/hot-path-bench
#   --check    exit 1 unless each ceilinged row is at or under its ceiling in 2 of the last 3 logs
#   (none)     print the latest log beside the ceilings
#
# spawn_exec is `run.start` to the exit of a run that boots lain, not to a chat's registration.
#
# Not a spec: a record takes minutes, and a time asserted in a spec is a flake.
#
# A record waits for the suite lock, then measures in a child under a stripped environment, nice
# and ionice, once per padding of the environment: padding moves memory layout, so the range of a
# row's medians across paddings is the noise a few-percent gap has to beat.
module HotPathBench
  REPO_ROOT = Pathname(__dir__).join("..").expand_path
  RECORDS = REPO_ROOT.join("tmp/hot-path-bench")
  PADDINGS = [0, 512, 1024, 2048].freeze
  CHILD_TIMEOUT = 1800
  PASSED_THROUGH = %w[PATH HOME TMPDIR LD_LIBRARY_PATH LANG BUNDLE_GEMFILE GEM_HOME GEM_PATH RUBYLIB].freeze
  NOISY = 0.10
  # Without these glibc trims the heap top after the large chained journal line is freed and the next record
  # refaults about 2 MB, so the row flips between 0.8 and 1.3 ms on which repetitions are the majority;
  # measured with this exact string, both trees settle at 0.78 to 0.94 ms.
  MALLOC_TUNABLES = "glibc.malloc.mmap_threshold=33554432:glibc.malloc.trim_threshold=268435456:" \
                    "glibc.malloc.top_pad=67108864"

  # Milliseconds. Seed each from 3 quiet-box logs at 1.25x the largest of the 3 medians, rounded up;
  # a nil is a row nobody has budgeted yet, and `--check` fails on it. Lowering one is free; raising one
  # is its own commit, saying why. request_100000 sits at 1.17: its instructions crept from about 3.7M to
  # 6.0M per rep across the epic and approval commits with no single step, and its wall time is bimodal
  # under memory layout, so it was re-seeded from 3 fresh medians rather than bisected further.
  CEILINGS = {
    "render_chat_10k" => 18.3,
    "render_cold_10k" => 111,
    "bash_true_none" => 3.09,
    "bash_true_traced" => 7.92,
    "bash_true_reader" => 12.2,
    "bash_true_workspace" => 17.8,
    "request_100000" => 1.17,
    "request_1000000" => 2.98,
    "request_guarded_1000000" => 5.49,
    "journal_small" => 0.0052,
    "journal_1000000" => 0.971,
    "journal_chained_small" => 0.00738,
    "journal_chained_1000000" => 1.08,
    "mask_first_output" => 0.263,
    "wire_ready" => 17.1,
    "credential_scan_assignment" => 37.7,
    "credential_scan_gated" => 63.7,
    "mask_list_warm" => 4.45,
    "spawn_exec" => 879
  }.freeze

  SCAN_SIZE = 100_000
  SCAN_REPS = 21
  SPAWN_REPS = 11
  SPAWN_POLL = 0.002
  SPAWN_DEADLINE = 30
  # Stands in for exe/lain and sends it `help`: a real chores run would do work this row must not time.
  SPAWN_STAND_IN = "ARGV.replace(%<argv>s)\nload %<exe>s\n"

  HotPaths = Lain::Bench::HotPaths

  module_function

  def records = HotPaths::Records.new(dir: RECORDS.to_s)

  def logs = records.texts.map { HotPaths::Log.parse(_1) }

  def measure
    hot_paths = HotPaths.new
    puts JSON.generate([*hot_paths.rows, *credential_scan_rows(hot_paths), spawn_exec_row(hot_paths)].map(&:to_h))
  end

  # A backtracking shape stalls every read and write it guards on a long unbroken line; Ruby cannot
  # judge these shapes linear, so the cost is held to a ceiling here rather than timed in a spec.
  def credential_scan_rows(hot_paths)
    write = Lain::CredentialPatterns.for(:write)
    gated = ["quoted password key", "url credentials", "bearer header", "password variable assignment"]
    [["credential_scan_assignment", [write.fetch("credential assignment"),
                                     Lain::CredentialPatterns.for(:content).fetch("credential literal assignment")],
      assignment_lines], ["credential_scan_gated", write.values_at("github token", *gated), gated_lines]]
      .map { |name, shapes, lines| scan_row(hot_paths, name, shapes, lines) }
  end

  def scan_row(hot_paths, name, shapes, lines)
    hot_paths.measure(SCAN_REPS, name:) { shapes.product(lines).each { |shape, line| line.match?(shape) } }
  end

  def assignment_lines
    ["token=" * (SCAN_SIZE / 6), "token=#{"a" * SCAN_SIZE}1", "x_token=#{"a" * SCAN_SIZE}(",
     "token=abcdefg1(" * (SCAN_SIZE / 15)]
  end

  def gated_lines
    a = "a" * SCAN_SIZE
    ["A_PWD=" * (SCAN_SIZE / 6), "A_PWD=#{a}1(", "A#{"_" * SCAN_SIZE}", "#{"A" * SCAN_SIZE}PWD=x", "A_PWD='#{a}",
     "A_PASSWORD=\"$(#{a}", %("password": "#{a}), %("password": "${#{a}), "postgres://#{a}",
     "postgres://a:#{"b" * SCAN_SIZE}", "postgres://a:$#{"B" * SCAN_SIZE}", "ghp_#{a}",
     "Authorization: Bearer #{a} ", "Authorization: Bearer x" * (SCAN_SIZE / 25), "a:" * (SCAN_SIZE / 2)]
  end

  # spawn_exec times `run.start` up to the exit of a run that boots lain (exec, ruby boot, `require "lain"`,
  # Thor's parse, `help`). It is not registration. A forked-parent row must time the same endpoint to compare.
  def spawn_exec_row(hot_paths)
    Dir.mktmpdir("spawn") do |dir|
      env = spawn_env(dir)
      launch = spawn_launch(dir, env)
      return spawn_skipped unless File.executable?(launch.binary)

      Sync { measured_spawns(hot_paths, launch, Lain::Paths.new(env:), env, dir) }
    end
  end

  def spawn_skipped
    HotPaths::Row.new(name: "spawn_exec", median_ms: nil, spread_ms: nil, reps: 0, skipped: "lain-daemon is not built")
  end

  def spawn_env(dir)
    ENV.slice(*PASSED_THROUGH).merge("XDG_RUNTIME_DIR" => dir, "XDG_STATE_HOME" => File.join(dir, "state"),
                                     "XDG_CONFIG_HOME" => File.join(dir, "config"),
                                     "XDG_CACHE_HOME" => File.join(dir, "cache"), "HOME" => dir)
  end

  def spawn_launch(dir, env)
    stand_in = File.join(dir, "stand-in", "lain")
    FileUtils.mkdir_p(File.dirname(stand_in))
    exe = REPO_ROOT.join("exe/lain").to_s
    File.write(stand_in, format(SPAWN_STAND_IN, argv: ["help"].inspect, exe: exe.inspect))
    Lain::Daemon::Launch.current(paths: Lain::Paths.new(env:), env:).with(lain: stand_in)
  end

  def measured_spawns(hot_paths, launch, paths, env, dir)
    client = Lain::Daemon.ensure(paths:, env:, launch:)
    root = File.join(dir, "project")
    FileUtils.mkdir_p(File.join(root, ".git"))
    # The child's HOME and cache are fresh, so the first run would pay a bootsnap compile a real run does not.
    ran(client, root)
    hot_paths.measure(SPAWN_REPS, name: "spawn_exec") { ran(client, root) }
  ensure
    client&.stop
    Lain::Daemon.stop(paths:)
  end

  def ran(client, root)
    id = client.call("run.start", [{ "kind" => "chores", "root" => root }]).fetch("id")
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + SPAWN_DEADLINE
    until client.call("run.list").find { _1["id"] == id }.fetch("status")
      if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
        raise "spawn_exec: run #{id} had not ended in #{SPAWN_DEADLINE}s"
      end

      sleep(SPAWN_POLL)
    end
  end

  def record
    Lain::Isolation::SuiteLock.holding(paths: Lain::Paths.new, notice: ->(text) { warn text }) do
      started = Time.now
      log = measured_log
      records.write(log.dump)
      show(log)
      puts format("recorded in %.0fs", Time.now - started)
    end
  end

  def measured_log
    rows = HotPaths::Sweep.merge(PADDINGS.map { |padding| child_rows(padding) })
    HotPaths::Log.new(rows:, sha:, loadavg: File.read("/proc/loadavg").split.first(3).join(" "),
                      workers: ENV.fetch("LAIN_SPEC_WORKERS", "unset"))
  end

  def child_rows(padding)
    env = ENV.slice(*PASSED_THROUGH).merge("AB_PAD" => "x" * padding, "GLIBC_TUNABLES" => MALLOC_TUNABLES)
    out, err, status = Open3.capture3("timeout", CHILD_TIMEOUT.to_s, "nice", "-n", "19", "ionice", "-c3",
                                      "env", "-i", *env.map { |name, value| "#{name}=#{value}" },
                                      RbConfig.ruby, __FILE__, "--measure")
    abort("hot-path-bench: a measuring child failed (#{status.exitstatus}):\n#{err}") unless status.success?

    JSON.parse(out).map { |row| HotPaths::Row.new(**row.transform_keys(&:to_sym)) }
  end

  def sha
    out, status = Open3.capture2("git", "-C", REPO_ROOT.to_s, "rev-parse", "--short", "HEAD", err: File::NULL)
    status.success? ? out.strip : "unknown"
  end

  def show(log)
    puts "sha #{log.sha}  loadavg #{log.loadavg}  workers #{log.workers}"
    log.rows.each { |row| puts line(row) }
  end

  def line(row)
    return format("%-20<name>s skipped: %<why>s", name: row.name, why: row.skipped) if row.skipped

    noisy = row.spread_ms > row.median_ms * NOISY ? "  NOISY" : ""
    ceiling = CEILINGS[row.name]
    format("%-20<name>s %10.3<median>f ms  spread %9.3<spread>f  ceiling %<ceiling>s%<noisy>s",
           name: row.name, median: row.median_ms, spread: row.spread_ms, ceiling: ceiling || "unseeded", noisy:)
  end

  def report
    latest = logs.last or abort("hot-path-bench: nothing recorded; run --record first")
    show(latest)
  end

  def verify
    failures = HotPaths::Check.new(CEILINGS).failures(logs.map(&:rows))
    puts(failures.empty? ? "ok" : failures.map { "FAIL #{_1}" })
    exit 1 if failures.any?
  end

  # --measure is the child --record spawns under a stripped environment; it prints rows as JSON.
  USAGE = "usage: bin/hot-path-bench [--record | --check | --measure]"
  MODES = { nil => :report, "--record" => :record, "--check" => :verify, "--measure" => :measure }.freeze

  def run(argv)
    mode = MODES[argv.first] if argv.size <= 1
    return warn(USAGE) || exit(2) unless mode

    public_send(mode)
  end
end

HotPathBench.run(ARGV) if $PROGRAM_NAME == __FILE__
