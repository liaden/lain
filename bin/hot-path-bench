#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "fileutils"
require "lain"
require "open3"
require "pathname"
require "rbconfig"
require "tmpdir"

# Guards the chat-turn, bash-call, request and journal paths the way `bin/runtime-census` guards the
# suite's wall: `--record` keeps the last 3 logs, `--check` exits 1 when a row is over its ceiling in
# 2 of them.
#
#   --record   measure every row and keep the log under tmp/hot-path-bench
#   --check    exit 1 unless each ceilinged row is at or under its ceiling in 2 of the last 3 logs
#   (none)     print the latest log beside the ceilings
#
# spawn_exec and spawn_fork are `run.start` to the exit of a run that boots lain, not to a chat's
# registration; spawn_fork's run is forked from the daemon's warmed spawner. spawn_fork_private_mb
# (Linux) is the memory a forked run holds that it does not share, read as its `help` ends.
#
# Not a spec: a record takes minutes, and a time asserted in a spec is a flake.
#
# A record waits for the suite lock, then measures in a child under a stripped environment, nice
# and ionice, once per padding of the environment: padding moves memory layout, so the range of a
# row's medians across paddings is the noise a few-percent gap has to beat.
module HotPathBench
  REPO_ROOT = Pathname(__dir__).join("..").expand_path
  RECORDS = REPO_ROOT.join("tmp/hot-path-bench")
  PADDINGS = [0, 512, 1024, 2048].freeze
  CHILD_TIMEOUT = 1800
  PASSED_THROUGH = %w[PATH HOME TMPDIR LD_LIBRARY_PATH LANG BUNDLE_GEMFILE GEM_HOME GEM_PATH RUBYLIB].freeze
  NOISY = 0.10
  # Without these glibc trims the heap top after the large chained journal line is freed and the next record
  # refaults about 2 MB, so the row flips between 0.8 and 1.3 ms on which repetitions are the majority;
  # measured with this exact string, both trees settle at 0.78 to 0.94 ms.
  MALLOC_TUNABLES = "glibc.malloc.mmap_threshold=33554432:glibc.malloc.trim_threshold=268435456:" \
                    "glibc.malloc.top_pad=67108864"

  # Milliseconds. Seed each from 3 quiet-box logs at 1.25x the largest of the 3 medians, rounded up;
  # a nil is a row nobody has budgeted yet, and `--check` fails on it. Lowering one is free; raising one
  # is its own commit, saying why. request_100000 sits at 1.17: its instructions crept from about 3.7M to
  # 6.0M per rep across the epic and approval commits with no single step, and its wall time is bimodal
  # under memory layout, so it was re-seeded from 3 fresh medians rather than bisected further.
  CEILINGS = {
    "render_chat_10k" => 18.3,
    "render_cold_10k" => 111,
    "bash_true_none" => 3.09,
    "bash_true_traced" => 7.92,
    "bash_true_reader" => 12.2,
    "bash_true_workspace" => 17.8,
    "bash_true_workspace_masked" => nil,
    "request_100000" => 1.17,
    "request_1000000" => 2.98,
    "request_guarded_1000000" => 5.49,
    "journal_small" => 0.0052,
    "journal_1000000" => 0.971,
    "journal_chained_small" => 0.00738,
    "journal_chained_1000000" => 1.08,
    "mask_first_output" => 0.263,
    "wire_ready" => 17.1,
    "credential_scan_assignment" => 37.7,
    "credential_scan_gated" => 63.7,
    "mask_list_warm" => 4.45,
    "spawn_exec" => 879,
    "spawn_fork" => 52.0,
    "spawn_fork_private_mb" => 11.5
  }.freeze

  SCAN_SIZE = 100_000
  SCAN_REPS = 21
  SPAWN_REPS = 11
  SPAWN_POLL = 0.002
  SPAWN_DEADLINE = 30
  # Stands in for exe/lain and sends it `help`: a real chores run would do work these rows must not
  # time. As `daemon spawner` it runs the row's own spawner instead.
  SPAWN_STAND_IN = <<~RUBY
    if ARGV == ["daemon", "spawner"]
      %<spawner>s
    end
    ARGV.replace(["help"])
    load %<exe>s
  RUBY
  # A spawner that refuses every request, so every run starts by exec. It stays up, so no rep boots
  # another Ruby, as a daemon whose spawner exited would on each start.
  REFUSING_SPAWNER = <<~'RUBY'
    require "socket"
    socket = UNIXSocket.for_fd(0)
    socket.write("{\"error\":\"this row runs by exec\"}\n") while socket.gets
    exit
  RUBY
  # The real spawner, forking `help` where the daemon asks for a chores run. Its name is not exe/lain's,
  # so loading exe/lain defines LainCLI without starting it.
  HELP_SPAWNER = <<~'RUBY'
    $PROGRAM_NAME = "spawner"
    load %<exe>s
    Lain::Daemon::Spawner.on_stdin(starter: lambda { |_argv|
      LainCLI.start(["help"])
      rollup = "/proc/self/smaps_rollup"
      if File.exist?(rollup)
        private_kb = File.read(rollup).scan(/^Private_(?:Clean|Dirty):\s+(\d+)/).sum { _1.first.to_i }
        File.write(File.join(%<dir>s, "private", Process.pid.to_s), private_kb.to_s)
      end
    }).call
    exit
  RUBY

  # A spawn row: what stands in for `daemon spawner`, how many runs precede the timed ones, and whether
  # its runs fork. The daemon boots its spawner at its first run, which starts by exec, so the fork row's
  # first fork is its second warm-up, the one that waits out the spawner's own boot.
  Spawn = Data.define(:name, :spawner, :warmups, :forks)
  SPAWNS = [Spawn.new(name: "spawn_exec", spawner: REFUSING_SPAWNER, warmups: 1, forks: false),
            Spawn.new(name: "spawn_fork", spawner: HELP_SPAWNER, warmups: 2, forks: true)].freeze

  HotPaths = Lain::Bench::HotPaths

  module_function

  def records = HotPaths::Records.new(dir: RECORDS.to_s)

  def logs = records.texts.map { HotPaths::Log.parse(_1) }

  def measure
    hot_paths = HotPaths.new
    puts JSON.generate([*hot_paths.rows, *masked_bash_rows(hot_paths), *credential_scan_rows(hot_paths),
                        *spawn_rows(hot_paths)].map(&:to_h))
  end

  MASKED_REPS = 50
  MASKED_RULING = Lain::Approval::Escalation::Ruling.allow(rung: Lain::Approval::Judged::NAME, because: "bench")

  # bash_true_workspace runs with no masks; this is the same call in a Rails-shaped repo whose key, tracked
  # credentials and .env are masked, so it pays the mask descriptors and the git guard a real project pays.
  def masked_bash_rows(hot_paths)
    Dir.mktmpdir("hot-path-masked") do |dir|
      root = File.realpath(dir)
      masked_repo(root)
      exec, request = masked_call(root)
      call = -> { exec.call(command: "true", cwd: root, env: {}, timeout: 10, confinement: request) }
      ran = call.call
      return [masked_skipped("the masked call exited #{ran.exit_status}: #{ran.stderr.lines.first}")] unless
        ran.exit_status.zero?

      [hot_paths.measure(MASKED_REPS, name: "bash_true_workspace_masked") { call.call }]
    end
  rescue Lain::Error => e
    [masked_skipped(e.message)]
  end

  def masked_repo(root)
    files = { "config/master.key" => "#{"0" * 32}\n", "config/credentials.yml.enc" => "sealed\n",
              ".env" => "SECRET=1\n", "app.rb" => "app\n" }
    files.each do |path, text|
      FileUtils.mkdir_p(File.dirname(File.join(root, path))) && File.write(File.join(root, path), text)
    end
    git = ->(*args) { system(Lain::Isolation::Worktree::GIT_SPAWN_ENV, "git", "-C", root, *args, exception: true) }
    git.call("init", "-q")
    git.call("add", "config/credentials.yml.enc", "app.rb")
    git.call("-c", "user.name=bench", "-c", "user.email=bench@x", "commit", "-qm", "seed")
  end

  def masked_call(root)
    journal = Lain::Channel::Null.instance
    fence = Lain::Confine::Bwrap.fence_binary
    policy = Lain::Sensitivity::Policy.new(sensitivity: Lain::Sensitivity.new(home: Dir.home, cwd: root))
    masks = Lain::Confine::MaskList.new(root:, policy: -> { policy })
    box = Lain::Confine::Sandbox.new(root:, home: Dir.home, masks:, fence:, journal:, workspace: true,
                                     probe: Lain::Confine::Probe.new(fence:, journal:),
                                     tmpdir: File.join(root, "tmp").tap { FileUtils.mkdir_p(_1) })
    exec = box.wrap(Lain::Exec::Local.new, requirer: "bin/hot-path-bench")
    box.prime
    [exec, Lain::Confine::Request.new(ruling: MASKED_RULING, executables: [], cwd: root, root:, tool_use_id: "bench")]
  end

  def masked_skipped(why)
    HotPaths::Row.new(name: "bash_true_workspace_masked", median_ms: nil, spread_ms: nil, reps: 0, skipped: why)
  end

  # A backtracking shape stalls every read and write it guards on a long unbroken line; Ruby cannot
  # judge these shapes linear, so the cost is held to a ceiling here rather than timed in a spec.
  def credential_scan_rows(hot_paths)
    write = Lain::CredentialPatterns.for(:write)
    gated = ["quoted password key", "url credentials", "bearer header", "password variable assignment"]
    [["credential_scan_assignment", [write.fetch("credential assignment"),
                                     Lain::CredentialPatterns.for(:content).fetch("credential literal assignment")],
      assignment_lines], ["credential_scan_gated", write.values_at("github token", *gated), gated_lines]]
      .map { |name, shapes, lines| scan_row(hot_paths, name, shapes, lines) }
  end

  def scan_row(hot_paths, name, shapes, lines)
    hot_paths.measure(SCAN_REPS, name:) { shapes.product(lines).each { |shape, line| line.match?(shape) } }
  end

  def assignment_lines
    ["token=" * (SCAN_SIZE / 6), "token=#{"a" * SCAN_SIZE}1", "x_token=#{"a" * SCAN_SIZE}(",
     "token=abcdefg1(" * (SCAN_SIZE / 15)]
  end

  def gated_lines
    a = "a" * SCAN_SIZE
    ["A_PWD=" * (SCAN_SIZE / 6), "A_PWD=#{a}1(", "A#{"_" * SCAN_SIZE}", "#{"A" * SCAN_SIZE}PWD=x", "A_PWD='#{a}",
     "A_PASSWORD=\"$(#{a}", %("password": "#{a}), %("password": "${#{a}), "postgres://#{a}",
     "postgres://a:#{"b" * SCAN_SIZE}", "postgres://a:$#{"B" * SCAN_SIZE}", "ghp_#{a}",
     "Authorization: Bearer #{a} ", "Authorization: Bearer x" * (SCAN_SIZE / 25), "a:" * (SCAN_SIZE / 2)]
  end

  # Each spawn row times `run.start` up to the exit of a run that boots lain (ruby boot or fork, `require
  # "lain"`, Thor's parse, `help`). It is not registration. Both rows time the same endpoint, so they compare.
  def spawn_rows(hot_paths) = SPAWNS.flat_map { spawn_row(hot_paths, _1) }

  def spawn_row(hot_paths, spawn)
    Dir.mktmpdir("spawn") do |dir|
      env = spawn_env(dir)
      launch = spawn_launch(dir, env, spawn.spawner)
      return [spawn_skipped(spawn.name)] unless File.executable?(launch.binary)

      Sync { measured_spawns(hot_paths, spawn, launch, env, dir) }
    end
  end

  def spawn_skipped(name)
    HotPaths::Row.new(name:, median_ms: nil, spread_ms: nil, reps: 0, skipped: "lain-daemon is not built")
  end

  def spawn_env(dir)
    ENV.slice(*PASSED_THROUGH).merge("XDG_RUNTIME_DIR" => dir, "XDG_STATE_HOME" => File.join(dir, "state"),
                                     "XDG_CONFIG_HOME" => File.join(dir, "config"),
                                     "XDG_CACHE_HOME" => File.join(dir, "cache"), "HOME" => dir)
  end

  def spawn_launch(dir, env, spawner)
    stand_in = File.join(dir, "stand-in", "lain")
    FileUtils.mkdir_p([File.dirname(stand_in), File.join(dir, "private")])
    exe = REPO_ROOT.join("exe/lain").to_s.inspect
    File.write(stand_in, format(SPAWN_STAND_IN, spawner: format(spawner, exe:, dir: dir.inspect), exe:))
    Lain::Daemon::Launch.current(paths: Lain::Paths.new(env:), env:).with(lain: stand_in)
  end

  def measured_spawns(hot_paths, spawn, launch, env, dir)
    paths = Lain::Paths.new(env:)
    client = Lain::Daemon.ensure(paths:, env:, launch:)
    root = File.join(dir, "project")
    FileUtils.mkdir_p(File.join(root, ".git"))
    # The child's HOME and cache are fresh, so the first run would pay a bootsnap compile a real run does not.
    spawn.warmups.times { ran(client, root) }
    FileUtils.rm_f(Dir.glob(File.join(dir, "private", "*")))
    [hot_paths.measure(SPAWN_REPS, name: spawn.name) { ran(client, root) }, *private_row(spawn, dir)]
  ensure
    client&.stop
    Lain::Daemon.stop(paths:)
  end

  # Only forked runs write theirs, and only where /proc has it; there, a rep that wrote none started by
  # exec, and the fork row would be timing exec.
  def private_row(spawn, dir)
    return [] unless spawn.forks && File.exist?("/proc/self/smaps_rollup")

    samples = Dir.glob(File.join(dir, "private", "*")).map { File.read(_1).to_f / 1024 }
    unless samples.size == SPAWN_REPS
      raise "#{spawn.name}: #{SPAWN_REPS - samples.size} of #{SPAWN_REPS} reps did not fork"
    end

    stats = HotPaths::Stats
    [HotPaths::Row.new(name: "#{spawn.name}_private_mb", median_ms: stats.quantile(samples, 0.5),
                       spread_ms: stats.iqr(samples), reps: samples.size, skipped: nil)]
  end

  def ran(client, root)
    id = client.call("run.start", [{ "kind" => "chores", "root" => root }]).fetch("id")
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + SPAWN_DEADLINE
    until client.call("run.list").find { _1["id"] == id }.fetch("status")
      if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
        raise "spawn: run #{id} had not ended in #{SPAWN_DEADLINE}s"
      end

      sleep(SPAWN_POLL)
    end
  end

  def record
    Lain::Isolation::SuiteLock.holding(paths: Lain::Paths.new, notice: ->(text) { warn text }) do
      started = Time.now
      log = measured_log
      records.write(log.dump)
      show(log)
      puts format("recorded in %.0fs", Time.now - started)
    end
  end

  def measured_log
    rows = HotPaths::Sweep.merge(PADDINGS.map { |padding| child_rows(padding) })
    HotPaths::Log.new(rows:, sha:, loadavg: File.read("/proc/loadavg").split.first(3).join(" "),
                      workers: ENV.fetch("LAIN_SPEC_WORKERS", "unset"))
  end

  def child_rows(padding)
    env = ENV.slice(*PASSED_THROUGH).merge("AB_PAD" => "x" * padding, "GLIBC_TUNABLES" => MALLOC_TUNABLES)
    out, err, status = Open3.capture3("timeout", CHILD_TIMEOUT.to_s, "nice", "-n", "19", "ionice", "-c3",
                                      "env", "-i", *env.map { |name, value| "#{name}=#{value}" },
                                      RbConfig.ruby, __FILE__, "--measure")
    abort("hot-path-bench: a measuring child failed (#{status.exitstatus}):\n#{err}") unless status.success?

    JSON.parse(out).map { |row| HotPaths::Row.new(**row.transform_keys(&:to_sym)) }
  end

  def sha
    out, status = Open3.capture2("git", "-C", REPO_ROOT.to_s, "rev-parse", "--short", "HEAD", err: File::NULL)
    status.success? ? out.strip : "unknown"
  end

  def show(log)
    puts "sha #{log.sha}  loadavg #{log.loadavg}  workers #{log.workers}"
    log.rows.each { |row| puts line(row) }
  end

  def line(row)
    return format("%-20<name>s skipped: %<why>s", name: row.name, why: row.skipped) if row.skipped

    noisy = row.spread_ms > row.median_ms * NOISY ? "  NOISY" : ""
    ceiling = CEILINGS[row.name]
    format("%-20<name>s %10.3<median>f ms  spread %9.3<spread>f  ceiling %<ceiling>s%<noisy>s",
           name: row.name, median: row.median_ms, spread: row.spread_ms, ceiling: ceiling || "unseeded", noisy:)
  end

  def report
    latest = logs.last or abort("hot-path-bench: nothing recorded; run --record first")
    show(latest)
  end

  def verify
    failures = HotPaths::Check.new(CEILINGS).failures(logs.map(&:rows))
    puts(failures.empty? ? "ok" : failures.map { "FAIL #{_1}" })
    exit 1 if failures.any?
  end

  # --measure is the child --record spawns under a stripped environment; it prints rows as JSON.
  USAGE = "usage: bin/hot-path-bench [--record | --check | --measure]"
  MODES = { nil => :report, "--record" => :record, "--check" => :verify, "--measure" => :measure }.freeze

  def run(argv)
    mode = MODES[argv.first] if argv.size <= 1
    return warn(USAGE) || exit(2) unless mode

    public_send(mode)
  end
end

HotPathBench.run(ARGV) if $PROGRAM_NAME == __FILE__
