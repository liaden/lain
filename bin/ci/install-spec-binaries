#!/usr/bin/env bash
# Installs and asserts the binaries the suite drives: nvim, tmux, jq, bwrap, strace.
#
#   bin/ci/install-spec-binaries [--persist] [--print-url] [neovim-version]
#
# Works as root or through sudo, on x86_64 and aarch64. --persist keeps the
# user-namespace sysctl across reboots, and applies only when this run lifts it;
# --print-url prints the neovim tarball URL and exits, installing nothing. The
# version defaults to "stable".
set -euo pipefail

persist=0
print_url=0
# A moving "stable" on purpose: the :nvim specs drive nvim over msgpack-RPC, so
# tracking the release a developer has beats a pinned tag that drifts from dev boxes.
version=stable
for arg in "$@"; do
  case "$arg" in
    --persist) persist=1 ;;
    --print-url) print_url=1 ;;
    *) version=$arg ;;
  esac
done

nvim_arch() {
  case "$(uname -m)" in
    x86_64) echo x86_64 ;;
    aarch64 | arm64) echo arm64 ;;
    *) echo "unsupported machine: $(uname -m)" >&2; return 1 ;;
  esac
}

nvim_url() {
  echo "https://github.com/neovim/neovim/releases/download/${version}/nvim-linux-$(nvim_arch).tar.gz"
}

if [ "$print_url" -eq 1 ]; then
  nvim_url
  exit 0
fi

as_root() {
  if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

apt_updated=0
apt_install() {
  if [ "$apt_updated" -eq 0 ]; then
    as_root apt-get update -q
    apt_updated=1
  fi
  as_root apt-get install -y -q "$@"
}

install_missing() {
  local pkgs=() tool pkg
  for pair in bwrap:bubblewrap tmux:tmux jq:jq strace:strace curl:curl; do
    tool=${pair%%:*}
    pkg=${pair##*:}
    command -v "$tool" >/dev/null 2>&1 || pkgs+=("$pkg")
  done
  if [ ${#pkgs[@]} -ne 0 ]; then apt_install "${pkgs[@]}"; fi
}

# Ubuntu 24.04's AppArmor refuses an unprivileged user namespace, so bwrap
# cannot build the reader sandbox. A read-only /proc/sys (a container) cannot
# take the write, and the namespace assert below reports what that costs.
restore_userns() {
  as_root sysctl -w "$1=$2" || echo "warning: could not restore $1=$2" >&2
}

allow_userns() {
  local key=kernel.apparmor_restrict_unprivileged_userns conf=/etc/sysctl.d/60-lain-userns.conf old
  if ! old=$(as_root sysctl -n "$key" 2>/dev/null); then
    if [ -e "/proc/sys/${key//.//}" ]; then echo "warning: could not read $key" >&2; fi
    return 0
  fi
  if ! as_root sysctl -w "$key=0"; then
    echo "warning: could not set $key" >&2
    return 0
  fi
  if ! bwrap_namespace_works; then
    restore_userns "$key" "$old"
    return 0
  fi
  [ "$persist" -eq 1 ] || return 0
  if ! { echo "$key = 0" | as_root tee "$conf.tmp" >/dev/null && as_root mv "$conf.tmp" "$conf"; }; then
    as_root rm -f "$conf.tmp" || echo "warning: could not remove $conf.tmp" >&2
    restore_userns "$key" "$old"
    echo "::error::could not persist $key" >&2
    exit 1
  fi
}

# "stable" is a moving tag, so it resolves through the latest-release redirect to a version tag.
# An empty result means the lookup failed.
resolve_nvim_version() {
  if [ "$version" != stable ]; then echo "$version"; return 0; fi
  local resolved
  resolved=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/neovim/neovim/releases/latest 2>/dev/null | sed 's|.*/||') || true
  case "$resolved" in v[0-9]*) echo "$resolved" ;; *) echo "" ;; esac
}

# NOT apt: Ubuntu 24.04's neovim is 0.9.x, several minors behind a dev box, and
# the specs talk to it over RPC.
install_nvim() {
  local wanted installed
  wanted=$(resolve_nvim_version)
  if command -v nvim >/dev/null 2>&1; then
    installed=$(nvim --version | head -1 | awk '{print $2}')
    if [ -z "$wanted" ]; then
      echo "warning: could not resolve stable; keeping installed nvim $installed" >&2
      return 0
    fi
    if [ "$installed" = "$wanted" ]; then
      echo "skip: nvim $wanted already installed"
      return 0
    fi
  elif [ -z "$wanted" ]; then
    echo "::error::could not resolve stable and no nvim is installed" >&2
    return 1
  fi
  local tarball
  tarball=$(mktemp)
  curl -fsSL "$(nvim_url)" -o "$tarball"
  as_root tar -C /opt -xzf "$tarball"
  rm -f "$tarball"
  as_root ln -sf "/opt/nvim-linux-$(nvim_arch)/bin/nvim" /usr/local/bin/nvim
}

# Both suites SKIP silently when a binary is missing, so a gap reddens nothing
# and just stops testing the editor and the multiplexer. Assert instead.
assert_binaries() {
  local missing=() tool
  for tool in nvim tmux jq bwrap strace; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if [ ${#missing[@]} -ne 0 ]; then
    echo "::error::missing spec binaries: ${missing[*]} -- the specs that need them would SKIP, not fail" >&2
    return 1
  fi
  echo "nvim:   $(nvim --version | head -1)"
  echo "tmux:   $(tmux -V)"
  echo "jq:     $(jq --version)"
  echo "bwrap:  $(bwrap --version)"
  echo "strace: $(strace -V | head -1)"
}

# Mirrors the argv in lib/lain/confine/bwrap.rb, not just --unshare-user: that one passes on hosts
# where this argv fails with "Creating new namespace failed".
bwrap_namespace_works() {
  local as_user=()
  # Root is exempt from the AppArmor limit, so its pass says nothing about the user who runs lain.
  if [ "$(id -u)" -eq 0 ]; then as_user=(setpriv --reuid=65534 --regid=65534 --clear-groups); fi
  "${as_user[@]}" bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --unshare-pid --die-with-parent --unshare-net -- true
}

assert_bwrap_namespace() {
  if ! bwrap_namespace_works; then
    echo "::error::bwrap namespace assert failed: cannot build lain's reader namespace" >&2
    return 1
  fi
  echo "bwrap reader namespace: ok"
}

install_missing
# The restriction still protects unconfined calls, so lift it only on a host where bwrap needs that.
bwrap_namespace_works || allow_userns
install_nvim
assert_binaries
assert_bwrap_namespace
