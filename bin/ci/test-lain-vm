scenario_a_tree_holding_a_git_entry_is_refused() {
  guest_has_clone
  git -C "$HOST" config fetch.fsckObjects false
  local blob tree commit
  blob=$(printf 'x\n' | guest_git hash-object -w --stdin)
  tree=$(printf '100644 blob %s\t.git\n' "$blob" | guest_git mktree)
  commit=$(guest_git commit-tree -p HEAD -m evil "$tree")
  guest_git update-ref refs/heads/evil "$commit"
  lain_vm fetch evil
  expect_refused
  output_has "hasDotgit"
  ref_absent refs/remotes/lain-vm/evil
}

scenario_an_oversized_fetch_is_stopped() {
  guest_has_clone
  guest_branch big
  head -c 1048576 /dev/urandom >"$GUEST/lain/big.bin"
  guest_git add big.bin
  guest_git commit -q -m big
  LAIN_VM_FETCH_MAX_KB=64 lain_vm fetch big
  expect_refused
  log_has "ssh "
  output_has "File too large"
  ref_absent refs/remotes/lain-vm/big
  if find "$HOST/.git/objects" -name 'tmp_*' -size +128 | grep -q .; then fail "partial pack passed the cap"; fi
  lain_vm fetch big
  expect_success
  ref_is refs/remotes/lain-vm/big "$(guest_git rev-parse big)"
}

