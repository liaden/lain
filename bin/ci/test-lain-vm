blob_tree() {
  awk -v blob="$1" -v count="$2" \
    'BEGIN { for (i = 0; i < count; i++) printf "100644 blob %s\tf%d\n", blob, i }' | guest_git mktree
}

commit_tip_with_entries() {
  local target=$1 base blob leaf remaining whole rest rest_tree bomb root commit count
  base=$(guest_git ls-tree -r -t --full-tree main | wc -l)
  blob=$(printf 'x\n' | guest_git hash-object -w --stdin)
  leaf=$(blob_tree "$blob" 1000)
  remaining=$((target - base - 2))
  whole=$((remaining / 1001))
  rest=$((remaining - whole * 1001))
  if [ "$rest" -eq 0 ]; then
    whole=$((whole - 1))
    rest=1001
  fi
  rest_tree=$(blob_tree "$blob" "$rest")
  bomb=$({
    awk -v tree="$leaf" -v count="$whole" \
      'BEGIN { for (i = 0; i < count; i++) printf "040000 tree %s\td%d\n", tree, i }'
    printf '040000 tree %s\trest\n' "$rest_tree"
  } | guest_git mktree)
  root=$({
    guest_git ls-tree main
    printf '040000 tree %s\tbomb\n' "$bomb"
  } | guest_git mktree)
  commit=$(guest_git commit-tree -p main -m "entries $target" "$root")
  count=$(guest_git ls-tree -r -t --full-tree "$commit" | wc -l)
  [ "$((count))" -eq "$target" ] || fail "the fixture has $((count)) entries, not $target"
  guest_git update-ref "refs/heads/$2" "$commit"
}

