scenario_scripts_avoid_what_bash_3_2_and_bsd_tools_lack() {
  local file pattern
  for file in "$script" "$this_test"; do
    "$BASH" -n "$file" || fail "syntax error in $file"
    while IFS= read -r pattern; do
      if grep -nE -- "$pattern" "$file" >"$WORLD/hits"; then
        LC_ALL=C cat -v "$WORLD/hits" >&2
        fail "$file matches the banned pattern: $pattern"
      fi
    done <<'PATTERNS'
(declare|typeset|local)[[:space:]]+-[[:alpha:]]*[Agnlu]
map[f]ile
read[a]rray
co[p]roc
\$\{[[:alnum:]_]+(\[[^]]*\])?(,|\^)
[|]&
&>[>]
\$\{[[:alnum:]_]+\[-
printf[[:space:]]+-v[[:space:]]+[[:alnum:]_]+\[
\[@\]
=[~]
\[\[[[:space:]]+-v
\$\{[^}]*@[QEPAaKku]\}
wait[[:space:]]+-n
shopt[[:space:]]+-s[[:space:]]+(globstar|lastpipe|autocd|checkjobs)
(^|[^[:alnum:]_-])sed[[:space:]]+(-[[:alnum:]]+[[:space:]]+)*-[[:alpha:]]*i
readlink[[:space:]]+-[[:alpha:]]*f
(^|[[:space:]])date[[:space:]]+-[[:alpha:]]*d
(^|[^[:alnum:]_-])stat[[:space:]]+-[[:alpha:]]*c
grep[[:space:]]+-[[:alpha:]]*P
mktemp[[:space:]]+(-[[:alpha:]]+[[:space:]]+)*[^-[:space:])]
(^|[^[:alnum:]_-])timeout[[:space:]]
PATTERNS
  done
}

incoming_refs_gone() {
