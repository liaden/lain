scenario_fetch_stays_in_a_remote_tracking_ref() {
  guest_has_clone
  guest_branch work
  guest_commit_file notes.txt "from the guest"
  local tip head
  tip=$(guest_git rev-parse HEAD)
  head=$(git -C "$HOST" rev-parse HEAD)
  echo dirty >>"$HOST/notes.txt"
  git -C "$HOST" status --porcelain >"$WORLD/status-before"
  lain_vm fetch work
  expect_success
  ref_is refs/remotes/lain-vm/work "$tip"
  ref_is HEAD "$head"
  [ "$(git -C "$HOST" symbolic-ref --short HEAD)" = main ] || fail "host branch changed"
  git -C "$HOST" status --porcelain >"$WORLD/status-after"
  cmp -s "$WORLD/status-before" "$WORLD/status-after" || fail "host worktree changed"
  log_has "-o ForwardAgent=no -o ClearAllForwardings=yes"
  log_has "lima-testvm"
}

