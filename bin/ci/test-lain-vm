# The fake ignores TERM and waits on a file the test writes, so its late write cannot race the signal.
write_fetch_that_ignores_term() {
  local real_git tip
  real_git=$(command -v git)
  tip=$(git -C "$HOST" rev-parse HEAD)
  cat >"$WORLD/fakes/git" <<FAKE
#!/bin/sh
case " \$* " in
  *" --no-write-fetch-head "*)
    for last in "\$@"; do :; done
    trap '' TERM
    echo \$\$ >"$WORLD/fetch-pid"
    tries=0
    while [ ! -e "$WORLD/go" ] && [ "\$tries" -lt 150 ]; do
      sleep 0.1
      tries=\$((tries + 1))
    done
    "$real_git" -C "$HOST" update-ref "\${last#*:}" "$tip"
    : >"$WORLD/late-write"
    exit 1
    ;;
esac
exec "$real_git" "\$@"
FAKE
  chmod +x "$WORLD/fakes/git"
}

start_fetch_and_wait_for_the_fake() {
  local tries=0
  (cd "$HOST" && exec "$BASH" "$script" fetch work) </dev/null >"$OUT" 2>&1 &
  JOB=$!
  while [ ! -s "$WORLD/fetch-pid" ] && [ "$tries" -lt 100 ]; do
    sleep 0.1
    tries=$((tries + 1))
  done
  [ -s "$WORLD/fetch-pid" ] || fail "the fake fetch never started"
}

