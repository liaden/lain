list_scenarios() {
  grep -E '^scenario_[a-z0-9_]+\(\) \{$' "$this_test" | cut -d'(' -f1
}

passed=0
failed=0
for scenario in $(list_scenarios); do
  set +e
  (
    set -e
    build_world
    "$scenario"
  )
  status=$?
  set -e
  if [ "$status" -eq 0 ]; then
    passed=$((passed + 1))
    printf 'ok   %s\n' "$scenario"
  else
    failed=$((failed + 1))
    printf 'FAIL %s\n' "$scenario"
  fi
done

printf '%s scenarios passed, %s failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ] && [ "$passed" -gt 0 ]
