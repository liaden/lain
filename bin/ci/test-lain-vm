  while IFS= read -r name; do
    : >"$FAKE_LOG"
    lain_vm fetch "$name"
    expect_refused
    output_has "refused branch name"
    log_lacks "ssh "
    [ ! -e "$HOST/.git/FETCH_HEAD" ] || fail "fetch ran for: $name"
    [ ! -e "$HOST/pwned" ] || fail "name was executed: $name"
  done <<'NAMES'
--upload-pack=x
a:b
a*
+main
a;b
$(x)
$(touch pwned)
`touch pwned`
a..b
a/../b
-x
a b
a?b
a[b
a\b
a~1
a^b
é
.hidden
a.lock
a/
/a
@{-1}

NAMES
  lain_vm fetch "$(printf 'a\nb')"
  expect_refused
  lain_vm fetch "$(printf 'a\033b')"
  expect_refused
