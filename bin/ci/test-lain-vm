  output_has "shell"
  output_has "fetch <branch>"
  output_has "docs/users/lima.md"
}

scenario_up_builds_a_vm_from_the_current_commit() {
  cp "$WORLD/canary" "$HOST/.git/hooks/pre-push"
  git -C "$HOST" commit -q --allow-empty -m "local only"
  lain_vm up
  expect_success
  log_has "limactl start --tty=false --name=testvm $HOST/lima/lain.yaml"
  [ "$(git -C "$GUEST/lain" rev-parse HEAD)" = "$(git -C "$HOST" rev-parse HEAD)" ] || fail "guest is not at HEAD"
  [ "$(git -C "$GUEST/lain" symbolic-ref --short HEAD)" = vm-seed ] || fail "guest is not on vm-seed"
  [ ! -e "$GUEST/.lain-seed" ] || fail "seed directory left behind"
  log_has "-o ForwardAgent=no -o ClearAllForwardings=yes"
  canary_quiet
  grep '^step ' "$FAKE_LOG" >"$WORLD/steps"
  cat >"$WORLD/expected" <<'STEPS'
step install-toolchain
step install-spec-binaries --persist
step bundle exec rake compile
step bundle exec rake daemon:build
step install-shim
STEPS
  cmp -s "$WORLD/steps" "$WORLD/expected" || fail "install steps ran out of order"
  if grep '^limactl shell' "$FAKE_LOG" | grep -qv -- '--workdir'; then fail "a guest command lacks --workdir"; fi
}

