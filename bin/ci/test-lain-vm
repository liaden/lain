#!/bin/bash
# Tests bin/lain-vm with fake limactl and ssh against real git, so a Mac runner needs neither Ruby nor lain.
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_CONFIG_GLOBAL GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_EXTERNAL_DIFF \
  GIT_SSH GIT_SSH_COMMAND GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_DIFF_OPTS GIT_PAGER \
  LAIN_VM_NAME LAIN_VM_FETCH_MAX_KB LIMA_HOME XDG_CONFIG_HOME

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
script="$repo/bin/lain-vm"
this_test="$repo/bin/ci/test-lain-vm"

fail() {
  printf 'FAILED: %s\n' "$*" >&2
  if [ -f "${OUT:-}" ]; then
    printf -- '--- output ---\n' >&2
    LC_ALL=C cat -v "$OUT" >&2
  fi
  exit 1
}

write_fakes() {
  mkdir -p "$WORLD/fakes"
  cat >"$WORLD/fakes/limactl" <<'FAKE'
#!/bin/sh
printf 'limactl %s\n' "$*" >>"$FAKE_LOG"
case "$1" in
  list)
    case "$2" in
      --quiet) if [ -f "$FAKE_ROOT/vm-exists" ]; then echo "$FAKE_VM"; fi ;;
      --format) cat "$FAKE_ROOT/vm-status" ;;
    esac
    ;;
  start)
    if [ -f "$FAKE_ROOT/limactl-noise" ]; then cat "$FAKE_ROOT/limactl-noise" >&2; fi
    : >"$FAKE_ROOT/vm-exists"
    echo Running >"$FAKE_ROOT/vm-status"
    ;;
  shell)
    [ "$2" = --workdir ] || exit 64
    [ "$4" = "$FAKE_VM" ] || exit 65
    shift 4
    if [ -f "$FAKE_ROOT/limactl-noise" ]; then cat "$FAKE_ROOT/limactl-noise" >&2; fi
    if [ "$1" = bash ] && [ "$2" = -c ] && [ -f "$FAKE_ROOT/state-answer" ]; then
      cat "$FAKE_ROOT/state-answer"
      exit 0
    fi
    cd "$FAKE_GUEST_HOME" || exit 66
    HOME=$FAKE_GUEST_HOME
    export HOME
    unset GIT_SSH_COMMAND XDG_CONFIG_HOME
    # A login shell would run path_helper on a Mac and put the real tools ahead of these fakes.
    if [ "$1" = bash ] && [ "$2" = -lc ]; then exec bash -c "$3"; fi
    exec "$@"
    ;;
esac
FAKE
  cat >"$WORLD/fakes/ssh" <<'FAKE'
#!/bin/sh
printf 'ssh %s\n' "$*" >>"$FAKE_LOG"
while [ $# -gt 0 ]; do
  case "$1" in
    -F | -o | -p) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
[ "$1" = "lima-$FAKE_VM" ] || exit 255
shift
if [ -f "$FAKE_ROOT/ssh-noise" ]; then cat "$FAKE_ROOT/ssh-noise" >&2; fi
if [ -f "$FAKE_ROOT/appears-during-seed" ]; then
  mkdir -p "$FAKE_GUEST_HOME/lain"
  : >"$FAKE_GUEST_HOME/lain/keep"
fi
cd "$FAKE_GUEST_HOME" || exit 255
HOME=$FAKE_GUEST_HOME
PATH="$(git --exec-path):$PATH"
export HOME PATH
unset GIT_SSH_COMMAND XDG_CONFIG_HOME
exec sh -c "$*"
FAKE
  cat >"$WORLD/fakes/bundle" <<'FAKE'
#!/bin/sh
printf 'step bundle %s\n' "$*" >>"$FAKE_LOG"
FAKE
  cat >"$WORLD/fakes/mise" <<'FAKE'
#!/bin/sh
exit 0
FAKE
  cat >"$WORLD/canary" <<'FAKE'
#!/bin/sh
: >"$FAKE_ROOT/canary-ran"
FAKE
  chmod +x "$WORLD/fakes/limactl" "$WORLD/fakes/ssh" "$WORLD/fakes/bundle" "$WORLD/fakes/mise" "$WORLD/canary"
}

write_stub_step() {
  # shellcheck disable=SC2016  # the text is a generated script
  printf '#!/bin/sh\nprintf "step %s%%s\\n" "${1:+ $1}" >>"$FAKE_LOG"\n' "$(basename "$1")" >"$1"
  chmod +x "$1"
}

write_project() {
  mkdir -p "$1/bin/ci" "$1/.github/workflows" "$1/lima"
  write_stub_step "$1/bin/ci/install-toolchain"
  write_stub_step "$1/bin/ci/install-spec-binaries"
  write_stub_step "$1/bin/install-shim"
  echo ruby-4.0.10 >"$1/.ruby-version"
  echo base >"$1/bin/tool"
  echo base >"$1/.github/workflows/main.yml"
  echo base >"$1/lima/lain.yaml"
  echo base >"$1/.pre-commit-config.yaml"
  echo base >"$1/Rakefile"
  echo base >"$1/Gemfile"
  echo base >"$1/Gemfile.lock"
  echo base >"$1/.envrc"
  echo notes-body >"$1/notes.txt"
}

build_world() {
  WORLD=$(cd "$(mktemp -d)" && pwd -P)
  trap 'rm -rf "$WORLD"' EXIT
  HOST="$WORLD/host"
  GUEST="$WORLD/guest"
  OUT="$WORLD/out"
  export HOME="$WORLD/home" GIT_CONFIG_NOSYSTEM=1 FAKE_ROOT="$WORLD" FAKE_LOG="$WORLD/log" FAKE_VM=testvm
  export FAKE_GUEST_HOME="$GUEST" LAIN_VM_NAME=testvm PATH="$WORLD/fakes:$PATH"
  mkdir -p "$HOME/.lima/testvm" "$GUEST"
  : >"$HOME/.lima/testvm/ssh.config"
  : >"$FAKE_LOG"
  git config --file "$HOME/.gitconfig" user.name tester
  git config --file "$HOME/.gitconfig" user.email tester@example.invalid
  git config --file "$HOME/.gitconfig" init.defaultBranch main
  cp "$HOME/.gitconfig" "$GUEST/.gitconfig"
  git config --file "$GUEST/.gitconfig" "url.file://$WORLD/upstream.git.insteadOf" https://github.com/liaden/lain
  write_fakes
  cat >"$WORLD/sensitive-paths" <<'PATHS'
.github/workflows/added.yml
bin/added
lima/added.yaml
.gitattributes
docs/deep/.gitattributes
.lfsconfig
.gitmodules
.mise.toml
mise.toml
.mise/tasks/x
.config/mise/config.toml
.tool-versions
rust-toolchain
rust-toolchain.toml
.cargo/config.toml
crates/x/.cargo/config.toml
.bundle/config
.rspec
lain.gemspec
rakelib/x.rake
.rubocop.yml
.rubocop/cops/x.rb
.config/other
.config/mise.toml
mise/config.toml
mise.local.toml
.mise.local.toml
crates/x/rust-toolchain
crates/x/rust-toolchain.toml
crates/x/.tool-versions
crates/x/.envrc
PATHS

  git init -q --bare "$WORLD/upstream.git"
  git init -q "$WORLD/seed"
  write_project "$WORLD/seed"
  git -C "$WORLD/seed" add -A
  git -C "$WORLD/seed" commit -q -m base
  git -C "$WORLD/seed" push -q "$WORLD/upstream.git" HEAD:refs/heads/main
  git clone -q "$WORLD/upstream.git" "$HOST"
}

vm_is_running() {
  : >"$WORLD/vm-exists"
  echo Running >"$WORLD/vm-status"
}

guest_has_clone() {
  vm_is_running
  git clone -q "$WORLD/upstream.git" "$GUEST/lain"
}

guest_git() { git -C "$GUEST/lain" -c core.ignorecase=false "$@"; }

guest_commit_file() {
  mkdir -p "$(dirname "$GUEST/lain/$1")"
  printf '%s\n' "$2" >>"$GUEST/lain/$1"
  guest_git add -- "$1"
  guest_git commit -q -m "change $1"
}

guest_branch() { guest_git switch -q -c "$1"; }

guest_stage_blob() {
  local blob
  blob=$(printf '%s\n' "$3" | guest_git hash-object -w --stdin)
  guest_git update-index --add --cacheinfo "$1,$blob,$2"
}

lain_vm() {
  set +e
  (cd "$HOST" && "$BASH" "$script" "$@") </dev/null >"$OUT" 2>&1
  RC=$?
  set -e
}

expect_success() { [ "$RC" -eq 0 ] || fail "expected success, exit was $RC"; }
expect_refused() { [ "$RC" -ne 0 ] || fail "expected a non-zero exit"; }
output_has() { grep -qF -- "$1" "$OUT" || fail "output lacks: $1"; }
output_lacks() { if grep -qF -- "$1" "$OUT"; then fail "output holds: $1"; fi; }
log_has() { grep -qF -- "$1" "$FAKE_LOG" || fail "log lacks: $1"; }
log_lacks() { if grep -qF -- "$1" "$FAKE_LOG"; then fail "log holds: $1"; fi; }
no_raw_escape() {
  if LC_ALL=C grep -q "$(printf '\033')" "$OUT"; then fail "raw escape byte in output"; fi
}
canary_quiet() { [ ! -e "$WORLD/canary-ran" ] || fail "guest content ran a host command"; }
ref_absent() {
  if git -C "$HOST" rev-parse --verify --quiet "$1" >/dev/null; then fail "ref exists: $1"; fi
}
ref_is() {
  [ "$(git -C "$HOST" rev-parse "$1")" = "$2" ] || fail "$1 is not $2"
}

scenario_help_names_the_subcommands_and_the_guide() {
  lain_vm --help
  expect_success
