stage_tip_totalling() {
  local target=$1 at_limit=16777216 base filler n blob
  base=$(guest_git ls-tree -r -l --full-tree HEAD | awk '$2 == "blob" { sum += $4 } END { printf "%.0f", sum }')
  filler=$((target - base - 63 * at_limit))
  mkdir -p "$WORLD/blobs"
  head -c "$at_limit" /dev/zero >"$WORLD/blobs/at-limit"
  head -c "$filler" /dev/zero >"$WORLD/blobs/filler"
  blob=$(guest_git hash-object -w "$WORLD/blobs/at-limit")
  n=0
  while [ "$n" -lt 63 ]; do
    n=$((n + 1))
    guest_git update-index --add --cacheinfo "100644,$blob,docs/copy$n"
  done
  blob=$(guest_git hash-object -w "$WORLD/blobs/filler")
  guest_git update-index --add --cacheinfo "100644,$blob,docs/filler"
  guest_git commit -q -m repeated
}

