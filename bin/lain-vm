#!/bin/bash
# shellcheck disable=SC2016  # single-quoted programs expand in the guest, never on the Mac
set -euo pipefail

vm=${LAIN_VM_NAME:-lain}
default_fetch_max_kb=1048576
fetch_max_kb=${LAIN_VM_FETCH_MAX_KB:-$default_fetch_max_kb}
sensitive_blob_max_bytes=8388608
sensitive_print_max_bytes=524288
max_sensitive_paths=50
max_listed_branch_paths=1000
max_tree_entries=200000
max_blob_bytes=16777216
max_tip_bytes=1073741824
fetch_job=
default_stop_grace_seconds=5
stop_grace_seconds=${LAIN_VM_STOP_GRACE_SECONDS:-$default_stop_grace_seconds}
incoming_ref=
newline=$'\n'
lain_root=
# Any of these would point git, or a relative cd, somewhere other than the lain root.
unset CDPATH GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR

usage() {
  cat <<'USAGE'
Usage: bin/lain-vm up|shell|fetch <branch>|secret <name>|--help

  up              start the VM, seed ~/lain if it is absent, install and build
  shell           open a login shell in ~/lain, with the saved provider keys exported
  fetch <branch>  fetch a VM branch into refs/remotes/lain-vm/<branch> and
                  print the full diff of sensitive paths against origin/main
  secret ANTHROPIC_API_KEY|OLLAMA_API_KEY
                  read a key at a hidden prompt and save it in the VM's
                  ~/.config/lain/provider.env; use a key made for this VM
  --help          show this help

LAIN_VM_NAME=<name> selects the VM (default lain). See docs/users/lima.md.
USAGE
}

die() {
  printf 'lain-vm: %s\n' "$*" >&2
  exit 1
}

sanitized() { LC_ALL=C cat -v; }

# The subshell scopes LC_ALL: under a UTF-8 collation these ranges can match non-ASCII letters.
valid_vm_name() (
  LC_ALL=C
  case "$1" in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._-]*) exit 1 ;;
  esac
)

valid_branch() (
  LC_ALL=C
  case "$1" in
    '' | -* | *..* | *[!A-Za-z0-9._/-]*) exit 1 ;;
  esac
  git check-ref-format --branch "$1" >/dev/null 2>&1
)

valid_size() (
  LC_ALL=C
  case "$1" in
    '' | 0* | *[!0-9]*) exit 1 ;;
  esac
  [ "${#1}" -le 7 ] && [ "$1" -le "$default_fetch_max_kb" ]
)

valid_grace() (
  LC_ALL=C
  case "$1" in
    '' | 0* | *[!0-9]*) exit 1 ;;
  esac
  [ "${#1}" -le 2 ]
)

require_vm_tools() {
  valid_vm_name "$vm" || die "refused VM name"
  command -v limactl >/dev/null 2>&1 || die "limactl is not installed"
}

# The root comes from this file's own path, never the caller's cwd, so a run from another repo cannot act on it.
# macOS before 12.3 has no readlink that resolves a whole chain, so each link is followed by hand.
find_lain_root() {
  local path=$1 dir target hops=0
  while [ -L "$path" ]; do
    [ "$hops" -lt 40 ] || return 1
    dir=$(cd -P "$(dirname "$path")" && pwd -P) || return 1
    target=$(readlink "$path") || return 1
    case "$target" in
      /*) path=$target ;;
      *) path=$dir/$target ;;
    esac
    hops=$((hops + 1))
  done
  dir=$(cd -P "$(dirname "$path")" && pwd -P) || return 1
  [ "$(basename "$dir")" = bin ] || return 1
  dir=$(cd -P "$dir/.." && pwd -P) || return 1
  printf '%s\n' "$dir"
}

enter_lain_root() { cd "$lain_root"; }

# A copy can sit inside some other repo, so the root must be the top level itself.
lain_root_is_checkout() {
  local top
  top=$(git -C "$lain_root" rev-parse --show-toplevel 2>/dev/null) || return 1
  top=$(cd -P "$top" && pwd -P) || return 1
  [ "$top" = "$lain_root" ]
}

# ControlMaster=no because a backgrounded master would hold the output pipe open and hang the command.
use_vm_transport() {
  local config="${LIMA_HOME:-$HOME/.lima}/$vm/ssh.config"
  [ -f "$config" ] || die "no ssh config for VM $vm; run bin/lain-vm up"
  GIT_SSH_COMMAND="ssh -F $(printf %q "$config") -o ForwardAgent=no -o ClearAllForwardings=yes -o ControlMaster=no -o ForwardX11=no -o ForwardX11Trusted=no -o PermitLocalCommand=no"
  export GIT_SSH_COMMAND
}

guest_run() {
  limactl shell --workdir / "$vm" bash -lc "$1" 2>&1 | sanitized
}

start_vm() {
  local names status
  names=$(limactl list --quiet 2>/dev/null) || die "could not list Lima VMs"
  case "
$names
" in
    *"
$vm
"*)
      status=$(limactl list --format '{{.Status}}' "$vm" 2>/dev/null) || die "could not read the VM status"
      if [ "$status" != Running ]; then limactl start --tty=false "$vm" 2>&1 | sanitized; fi
      ;;
    *) limactl start --tty=false --name="$vm" "$PWD/lima/lain.yaml" 2>&1 | sanitized ;;
  esac
}

guest_clone_state() {
  limactl shell --workdir / "$vm" bash -c \
    'if [ -e "$HOME/lain" ] || [ -L "$HOME/lain" ]; then echo present; else echo absent; fi' 2>/dev/null
}

exit_3_on_rule_prefixing_url() {
  local record value
  while IFS= read -r -d '' record; do
    value=${record#*"$newline"}
    [ "$value" != "$record" ] || continue
    case "$1" in
      "$value"*) exit 3 ;;
    esac
  done
}

# git has no query for an anonymous push URL, so any rewrite rule that prefixes the target is refused.
refuse_redirected_push() {
  local status=0
  git config -z --get-regexp '^url\..*\.(insteadof|pushinsteadof)$' 2>/dev/null |
    exit_3_on_rule_prefixing_url "$1" || status=$?
  case "$status" in
    0 | 1) ;;
    3) die "refused: git config would redirect the seed push" ;;
    *) die "could not read git config" ;;
  esac
}

exit_3_on_key_of_remote() {
  local key
  while IFS= read -r -d '' key; do
    case "$key" in
      "remote.$1."*) exit 3 ;;
    esac
  done
}

refuse_remote_settings() {
  local status=0
  git config -z --name-only --get-regexp '^remote\.' 2>/dev/null | exit_3_on_key_of_remote "$1" || status=$?
  case "$status" in
    0 | 1) ;;
    3) die "refused: git config holds settings for the remote $1" ;;
    *) die "could not read git config" ;;
  esac
}

# Seeding happens beside ~/lain, so a run that dies midway never leaves a clone that later runs would trust.
# The guest's receive-pack picks any push certificate nonce, so the push never signs and sends only HEAD's history.
# A credential prompt would hand what the user types to the guest, so no git that talks to it may prompt.
seed_guest_clone() {
  local seed_url="lima-$vm:.lain-seed"
  refuse_redirected_push "$seed_url"
  refuse_remote_settings "$seed_url"
  use_vm_transport
  guest_run 'set -eu
rm -rf "$HOME/.lain-seed"
GIT_TERMINAL_PROMPT=0 git clone -c remote.origin.pushurl=DISABLED https://github.com/liaden/lain "$HOME/.lain-seed"'
  GIT_TERMINAL_PROMPT=0 git -c core.hooksPath=/dev/null -c push.gpgSign=false -c push.followTags=false \
    push --no-verify --recurse-submodules=no "$seed_url" HEAD:refs/heads/vm-seed 2>&1 | sanitized
  guest_run 'set -eu
git -C "$HOME/.lain-seed" switch vm-seed
[ ! -e "$HOME/lain" ]
mv "$HOME/.lain-seed" "$HOME/lain"'
}

provision_script() {
  cat <<'GUEST'
set -euo pipefail
cd "$HOME/lain"
bin/ci/install-toolchain
bin/ci/install-spec-binaries --persist
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
eval "$(mise env -s bash "ruby@$(sed 's/^ruby-//' .ruby-version)")"
bundle exec rake compile
bundle exec rake daemon:build
bin/install-shim
GUEST
}

# The script travels inside 1 single-quoted word, so every quote in it is closed, escaped and reopened.
check_script() {
  local check quoted
  check=$(git cat-file blob HEAD:bin/ci/check-vm) || return 1
  quoted=$(printf '%s\n' "$check" | sed "s/'/'\\\\''/g") || return 1
  cat <<'GUEST'
set -euo pipefail
cd "$HOME/lain"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
eval "$(mise env -s bash "ruby@$(sed 's/^ruby-//' .ruby-version)")"
GUEST
  printf "exec bash -c '%s' check-vm\n" "$quoted"
}

# A confined call can rewrite the clone's copy, so the check that runs is the one committed on the Mac. It goes in
# the command, not on stdin, because the guest's login profile and its children could read stdin first.
run_committed_check() {
  local script
  script=$(check_script) || return 1
  limactl shell --workdir / "$vm" bash -lc "$script" </dev/null 2>&1 | sanitized
}

mac_port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

closed_mac_port() {
  local tries=0 port
  while [ "$tries" -lt 20 ]; do
    port=$((20000 + RANDOM % 20000))
    if ! mac_port_open "$port"; then
      printf '%s\n' "$port"
      return 0
    fi
    tries=$((tries + 1))
  done
  return 1
}

listener_says() { [ "$(head -c 64 "$1" 2>/dev/null | head -n 1)" = listening ]; }

# The guest cannot see Lima's host side, so only the Mac can tell whether a guest listener was forwarded.
# The listener is killed after a bounded wait, so a guest that never answers or never exits cannot hang up.
check_guest_ports_stay_in_the_vm() {
  local port dir pid tries=0 answer=unheld
  port=$(closed_mac_port) || die "found no closed Mac port to test guest port forwarding"
  dir=$(mktemp -d) || die "could not make a temporary directory"
  # The cap, in 1 KiB blocks, keeps a guest from filling the Mac's disk through its output.
  (ulimit -f 16; exec limactl shell --workdir / "$vm" python3 -c 'import socket, sys, time
listener = socket.socket()
listener.bind(("127.0.0.1", int(sys.argv[1])))
listener.listen(1)
print("listening", flush=True)
time.sleep(10)' "$port") </dev/null >"$dir/listener" 2>/dev/null &
  pid=$!
  while ! listener_says "$dir/listener" && [ "$tries" -lt 75 ] && kill -0 "$pid" 2>/dev/null; do
    sleep 0.2
    tries=$((tries + 1))
  done
  if listener_says "$dir/listener"; then
    sleep 5
    if mac_port_open "$port"; then answer=forwarded; else answer=closed; fi
  fi
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  rm -rf "$dir"
  case "$answer" in
    closed) printf 'lain-vm: guest port %s is not forwarded to the Mac\n' "$port" ;;
    forwarded) die "guest port $port is forwarded to the Mac" ;;
    *) die "could not hold a guest listener on port $port" ;;
  esac
}

cmd_up() {
  [ "$#" -eq 0 ] || die "up takes no arguments"
  require_vm_tools
  enter_lain_root
  [ -f lima/lain.yaml ] || die "lima/lain.yaml is missing"
  start_vm
  local state
  state=$(guest_clone_state) || die "could not read the guest's state"
  case "$state" in
    present) printf 'lain-vm: keeping the existing ~/lain\n' ;;
    absent) seed_guest_clone ;;
    *) die "unexpected answer from the guest" ;;
  esac
  guest_run "$(provision_script)"
  run_committed_check || die "the VM failed bin/ci/check-vm"
  check_guest_ports_stay_in_the_vm
}

# The key file is read line by line and never sourced, so it can set the 2 key names and nothing else, and runs no code.
# A hand edit can leave a CR or an empty value, and either would reach the provider as the key.
shell_script() {
  cat <<'GUEST'
cd "$HOME/lain" || exit 1
keys="$HOME/.config/lain/provider.env"
cr=$(printf '\r')
if [ -f "$keys" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%"$cr"}
    case "$line" in
      ANTHROPIC_API_KEY=?*) export ANTHROPIC_API_KEY="${line#*=}" ;;
      OLLAMA_API_KEY=?*) export OLLAMA_API_KEY="${line#*=}" ;;
    esac
  done <"$keys"
fi
exec "${SHELL:-/bin/bash}" -l
GUEST
}

cmd_shell() {
  [ "$#" -eq 0 ] || die "shell takes no arguments"
  require_vm_tools
  printf 'lain-vm: the VM writes straight to this terminal, unfiltered. It can set the clipboard and the title.\n' >&2
  exec limactl shell --workdir / "$vm" bash -lc "$(shell_script)"
}

valid_key_name() {
  case "$1" in
    ANTHROPIC_API_KEY | OLLAMA_API_KEY) return 0 ;;
  esac
  return 1
}

# Every exec in the VM carries the key in its environment, so a huge one would make them all fail.
valid_key() (
  LC_ALL=C
  case "$1" in
    '' | *[![:graph:]]*) exit 1 ;;
  esac
  [ "${#1}" -le 512 ]
)

require_running_vm() {
  [ "$(limactl list --format '{{.Status}}' "$vm" 2>/dev/null)" = Running ] ||
    die "VM $vm is not running; start it with bin/lain-vm up"
}

# The key arrives on stdin, so it is never in an argv a process listing shows. bash -c, not -lc: a login profile
# could read stdin first. The rename keeps a reader from seeing a half-written file. The temp file's name is under the
# denied rule, and one an earlier run left behind is replaced.
save_key_script() {
  printf 'name=%s\n' "$1"
  cat <<'GUEST'
set -eu
umask 077
dir="$HOME/.config/lain"
mkdir -p "$dir"
IFS= read -r value
tmp="$dir/provider.env.tmp"
rm -f "$tmp"
trap 'rm -f "$tmp"' EXIT
if [ -f "$dir/provider.env" ]; then
  grep -v "^$name=" "$dir/provider.env" >"$tmp" || [ "$?" -eq 1 ]
fi
printf '%s=%s\n' "$name" "$value" >>"$tmp"
mv -f "$tmp" "$dir/provider.env"
GUEST
}

cmd_secret() {
  [ "$#" -eq 1 ] || die "usage: bin/lain-vm secret ANTHROPIC_API_KEY|OLLAMA_API_KEY"
  local name=$1 value=
  valid_key_name "$name" || die "refused: secret saves only ANTHROPIC_API_KEY or OLLAMA_API_KEY"
  require_vm_tools
  require_running_vm
  if [ -t 0 ]; then
    IFS= read -r -s -p "$name: " value || true
    printf '\n' >&2
  else
    IFS= read -r value || true
  fi
  valid_key "$value" || die "refused: a key is 1 line of at most 512 printable characters with no spaces"
  printf '%s\n' "$value" | limactl shell --workdir / "$vm" bash -c "$(save_key_script "$name")" 2>&1 | sanitized ||
    die "could not save $name in the VM"
  printf 'lain-vm: saved %s in ~/.config/lain/provider.env in the VM.\n' "$name"
  printf 'A running tmux server keeps the key it started with. After a rotation, run tmux kill-server in the VM.\n'
}

# Every flag closes a way for guest content or a worktree .gitattributes to hide a change or run a driver.
hardened_diff() {
  git --no-pager -c core.quotePath=true diff --no-ext-diff --no-textconv --text --no-color --no-renames \
    --ignore-submodules=none --submodule=short -O/dev/null "$@"
}

sensitive_diff() {
  hardened_diff "$@" -- \
    ':(top,icase).github' ':(top,icase)bin' ':(top,icase)lima' ':(top,icase).pre-commit-config.yaml' \
    ':(top,icase)Rakefile' ':(top,icase)Gemfile' ':(top,icase)Gemfile.lock' ':(top,icase,glob)**/.envrc' \
    ':(top,icase,glob)**/.gitattributes' ':(top,icase).lfsconfig' ':(top,icase).gitmodules' \
    ':(top,icase,glob)**/mise.toml' ':(top,icase,glob)**/.mise.toml' \
    ':(top,icase,glob)**/mise.*.toml' ':(top,icase,glob)**/.mise.*.toml' \
    ':(top,icase,glob)**/.mise' ':(top,icase,glob)**/.mise/**' ':(top,icase,glob)**/mise' ':(top,icase,glob)**/mise/**' \
    ':(top,icase,glob)**/.config' ':(top,icase,glob)**/.config/**' \
    ':(top,icase,glob)**/.tool-versions' ':(top,icase).ruby-version' \
    ':(top,icase,glob)**/rust-toolchain*' \
    ':(top,icase,glob)**/.cargo' ':(top,icase,glob)**/.cargo/**' ':(top,icase).bundle' ':(top,icase).rspec' \
    ':(top,icase)*.gemspec' ':(top,icase)rakelib' ':(top,icase).rubocop.yml' ':(top,icase).rubocop' \
    ':(top,icase,glob)**/Cargo.toml' ':(top,icase,glob)**/Cargo.lock' ':(top,icase,glob)**/build.rs' \
    ':(top,icase,glob)**/extconf.rb' ':(top,icase,glob)**/Dockerfile*'
}

# Bash 3.2 has no wait with a timeout, so a child that ignores TERM is polled and then killed.
stop_fetch_job() {
  local waited=0
  [ -n "$fetch_job" ] || return 0
  kill -TERM -- "-$fetch_job" 2>/dev/null || true
  kill -CONT -- "-$fetch_job" 2>/dev/null || true
  while kill -0 "$fetch_job" 2>/dev/null && [ "$waited" -lt "$stop_grace_seconds" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  kill -KILL -- "-$fetch_job" 2>/dev/null || true
  wait "$fetch_job" 2>/dev/null || true
  fetch_job=
}

# The job stops first, so a dying fetch cannot write the ref back after it is removed.
remove_incoming() {
  stop_fetch_job
  [ -n "$incoming_ref" ] || return 0
  git -c core.hooksPath=/dev/null update-ref -d "$incoming_ref" >/dev/null 2>&1 || true
}

# A killed fetch leaves its ref, which keeps the guest's objects reachable. A live pid may be another fetch.
remove_stale_incoming() {
  local name pid
  git for-each-ref --format='%(refname)' refs/lain-vm-incoming/ 2>/dev/null | while IFS= read -r name; do
    pid=${name##*/}
    case "$pid" in
      '' | *[!0-9]*) ;;
      *) if kill -0 "$pid" 2>/dev/null; then continue; fi ;;
    esac
    git -c core.hooksPath=/dev/null update-ref -d "$name" >/dev/null 2>&1 || true
  done
}

refuse_weakened_fsck() {
  local status=0
  git config --name-only --get-regexp '^(fetch|transfer)\.fsck\.' >/dev/null 2>&1 || status=$?
  case "$status" in
    0) die "refused: a fetch.fsck or transfer.fsck setting weakens object checks" ;;
    1) ;;
    *) die "could not read git config" ;;
  esac
}

refuse_redirected_url() {
  [ "$(git ls-remote --get-url "$1")" = "$1" ] || die "refused: git config would redirect the fetch URL"
}

# Bash runs a trap only after a foreground child exits, so a hung ssh needs its own process group and wait.
fetch_branch() {
  local status=0
  set -m
  # The handler keeps the job leader alive until its pipeline exits, so waiting on it covers the fetch.
  # Its stderr is closed because a job notice written under stty tostop would stop it again.
  (trap : TERM; fetch_pipeline "$1" "$2") </dev/null 2>/dev/null &
  fetch_job=$!
  set +m
  wait "$fetch_job" || status=$?
  fetch_job=
  return "$status"
}

# fsck already forces index-pack; the unpack limits keep the fetch in 1 capped file if that choice changes.
# Accepted gap: only disk is capped, not memory. A delta chain, a zlib bomb in a tree or commit, or an unbounded ref
# advertisement can take gigabytes, and macOS ignores ulimit -v.
fetch_pipeline() {
  local branch=$1 url=$2
  (
    trap '' XFSZ
    ulimit -f "$fetch_max_kb"
    export GIT_TERMINAL_PROMPT=0
    exec git -c core.hooksPath=/dev/null -c gc.auto=0 -c maintenance.auto=false \
      -c transfer.fsckObjects=true -c fetch.fsckObjects=true \
      -c transfer.unpackLimit=1 -c fetch.unpackLimit=1 \
      fetch --no-tags --no-recurse-submodules --no-prune --no-write-fetch-head \
      "$url" "refs/heads/$branch:$incoming_ref"
  ) 2>&1 | sanitized
}

report_partial_packs() {
  local dir count
  dir=$(cd "$(git rev-parse --git-path objects/pack)" && pwd -P) || return 0
  count=$(find "$dir" -name 'tmp_pack_*' | wc -l)
  [ "$((count))" -gt 0 ] || return 0
  printf 'lain-vm: %s partial pack file(s) remain. If no other git command is running, remove them with:\n' \
    "$((count))" >&2
  printf '  rm -f %q/tmp_pack_*\n' "$dir" >&2
}

# ls-tree reads object headers for sizes, so a compressed bomb is never inflated here.
# The sum stops just past the cap, far inside the range an awk double holds exactly.
refuse_oversized_tree() {
  local status=0
  git ls-tree -r -t -l -z --full-tree "$1" 2>/dev/null | LC_ALL=C tr '\n\000' '?\n' |
    LC_ALL=C awk -v max_entries="$max_tree_entries" -v max_blob="$max_blob_bytes" -v max_total="$max_tip_bytes" '
      NR > max_entries { exit 3 }
      { split(substr($0, 1, index($0, "\t") - 1), field, " ") }
      field[2] == "blob" && field[4] + 0 > max_blob { exit 4 }
      field[2] == "blob" { total += field[4]; if (total > max_total) exit 5 }
    ' || status=$?
  case "$status" in
    0) ;;
    3) die "refused: the tip has too many entries (limit $max_tree_entries)" ;;
    4) die "refused: a file in the tip is too large (limit $max_blob_bytes bytes)" ;;
    5) die "refused: the total size of the tip is too large (limit $max_tip_bytes bytes)" ;;
    *) die "could not read the fetched tree" ;;
  esac
}

refuse_non_ascii_paths() {
  local high
  high=$(git ls-tree -r -t -z --name-only --full-tree "$1" | LC_ALL=C tr -d '\000-\177' | wc -c) ||
    die "could not read the fetched tree"
  [ "$((high))" -eq 0 ] || die "refused: the tip holds a non-ASCII path, which a Mac filesystem can fold"
}

# Names only and case-folded: git accepts symlinked objects and refs, a commondir file points them
# elsewhere, and a Mac filesystem folds case.
refuse_repository_shapes() {
  local found
  found=$(git ls-tree -r -t -z --full-tree "$1" | LC_ALL=C tr '\n\000' '?\n' | LC_ALL=C awk '
    {
      path = substr($0, index($0, "\t") + 1)
      slash = 0
      for (i = length(path); i > 0; i--) if (substr(path, i, 1) == "/") { slash = i; break }
      dir = substr(path, 1, slash)
      name = tolower(substr(path, slash + 1))
      if (name == "head") heads[dir] = 1
      if (name == "objects") objects[dir] = 1
      if (name == "refs") refs[dir] = 1
      if (name == "commondir") commondirs[dir] = 1
    }
    END {
      for (dir in heads)
        if ((dir in commondirs) || ((dir in objects) && (dir in refs))) print (dir == "" ? "." : dir)
    }
  ') || die "could not read the fetched tree"
  if [ -n "$found" ]; then
    printf '%s\n' "$found" | sanitized >&2
    die "refused: the tip holds a directory shaped like a git repository"
  fi
}

# The limits keep the whole review short enough that no change in it can scroll out of sight. Every printed list
# counts toward the byte limit, in escaped bytes since cat -v can grow a byte to 4; the blob limit bounds the work.
refuse_unreviewable_sensitive_change() {
  local base=$1 tip=$2 raw count total printed
  raw=$(sensitive_diff --raw --no-abbrev "$base" "$tip" 2>/dev/null) || die "could not list sensitive changes"
  if printf '%s\n' "$raw" | LC_ALL=C awk '$2 == "120000" { found = 1 } END { exit !found }'; then
    die "refused: a sensitive path is a new or changed symlink"
  fi
  count=$(printf '%s\n' "$raw" | LC_ALL=C awk 'NF >= 5 { n++ } END { print n + 0 }')
  [ "$count" -le "$max_sensitive_paths" ] ||
    refuse_unreviewable "too many sensitive paths ($count, limit $max_sensitive_paths)"
  total=$(printf '%s\n' "$raw" | LC_ALL=C awk 'NF >= 5 { print $3; print $4 }' |
    git cat-file --batch-check='%(objectsize)' |
    LC_ALL=C awk 'NF == 1 { sum += $1 } END { printf "%.0f\n", sum }') || die "could not size sensitive changes"
  [ "$total" -le "$sensitive_blob_max_bytes" ] ||
    refuse_unreviewable "the sensitive change is too large to print ($total bytes of files," \
      "limit $sensitive_blob_max_bytes)"
  printed=$(review_lists "$base" "$tip" | wc -c) || die "could not size the review"
  [ "$((printed))" -le "$sensitive_print_max_bytes" ] ||
    refuse_unreviewable "the changes are too large to review ($((printed)) bytes to print," \
      "limit $sensitive_print_max_bytes)"
}

refuse_unreviewable() {
  die "refused: $*. Read the branch in the VM instead, or split the change into smaller branches and fetch each."
}

# A collision is named only when an existing ref shows it; anything else is a write that failed.
colliding_ref() {
  git for-each-ref --format='%(refname)' refs/remotes/lain-vm/ 2>/dev/null | LC_ALL=C awk -v ref="$1" '
    {
      have = tolower($0)
      want = tolower(ref)
      if ($0 != ref && (have == want || index(want, have "/") == 1 || index(have, want "/") == 1)) { print; exit }
    }'
}

store_fetched_ref() {
  local ref=$1 tip=$2 old=$3 now lock other
  git -c core.hooksPath=/dev/null update-ref "$ref" "$tip" "$old" >/dev/null 2>&1 && return 0
  now=$(git rev-parse --verify --quiet "$ref" || true)
  [ "$now" = "$old" ] || die "another fetch moved $ref during the checks. This run changed nothing; run it again."
  lock=$(git rev-parse --git-path "$ref.lock")
  [ ! -e "$lock" ] ||
    die "another fetch holds the lock on $ref. If none is running, remove $(printf %q "$lock") and run it again."
  other=$(colliding_ref "$ref")
  [ -z "$other" ] || die "$ref collides with $other, which shares its name as a directory or up to case." \
    "This run changed nothing."
  die "could not write $ref; check the disk and the permissions of the git directory. This run changed nothing."
}

print_sensitive_paths() {
  printf '%s:\n' "$1"
  sensitive_diff --raw "$2" "$3" 2>&1 | sanitized
}

# Everything here comes from the guest's tree, so it is sized as a whole before any of it is printed. The
# whole-branch list stops at a line cap, so a large but honest branch still fits; it prints before the sensitive
# lists, so it cannot push them out of sight.
review_lists() {
  local base=$1 tip=$2
  hardened_diff --name-status "$base" "$tip" 2>&1 | sanitized | LC_ALL=C awk \
    -v max="$max_listed_branch_paths" -v base="$base" -v tip="$tip" '
    NR <= max { print }
    END {
      if (NR > max)
        printf "%d more paths not shown; list them all with git diff --name-status %s %s\n", NR - max, base, tip
    }'
  if ! sensitive_diff --quiet "$base" "$tip" 2>/dev/null; then
    print_sensitive_paths 'Sensitive paths changed' "$base" "$tip"
    sensitive_diff "$base" "$tip" 2>&1 | sanitized
    print_sensitive_paths 'Sensitive paths changed, the same list as before the diff' "$base" "$tip"
  fi
}

sensitive_path_count() {
  sensitive_diff --raw "$1" "$2" 2>/dev/null | LC_ALL=C awk 'NF >= 5 { n++ } END { print n + 0 }'
}

print_review() {
  local base=$1 tip=$2 branch=$3 count
  count=$(sensitive_path_count "$base" "$tip") || die "could not count sensitive changes"
  printf 'Every path the branch changes, origin/main (%s) to lain-vm/%s (%s):\n' "$base" "$branch" "$tip"
  review_lists "$base" "$tip"
  printf 'This list cannot make CI safe: any spec or build.rs also runs there. Review the whole branch before pushing.\n'
  printf 'To push the commit reviewed here, and nothing the VM adds later, run:\n'
  printf '  git push git@github-personal:liaden/lain %s:refs/heads/%s\n' "$tip" "$branch"
  case "$count" in
    1) printf '1 sensitive path changed.\n' ;;
    *) printf '%s sensitive paths changed.\n' "$count" ;;
  esac
}

cmd_fetch() {
  [ "$#" -eq 1 ] || die "usage: bin/lain-vm fetch <branch>"
  local branch=$1 url ref base tip old
  valid_branch "$branch" || die "refused branch name"
  valid_size "$fetch_max_kb" || die "refused fetch size limit"
  valid_grace "$stop_grace_seconds" || die "refused stop grace"
  require_vm_tools
  enter_lain_root
  refuse_weakened_fsck
  url="lima-$vm:lain"
  refuse_redirected_url "$url"
  refuse_remote_settings "$url"
  base=$(git rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}') || die "origin/main is missing"
  use_vm_transport
  ref="refs/remotes/lain-vm/$branch"
  incoming_ref="refs/lain-vm-incoming/$$"
  trap remove_incoming EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  remove_incoming
  remove_stale_incoming
  fetch_branch "$branch" "$url" || refuse_failed_fetch "$?"
  tip=$(git rev-parse --verify --quiet "$incoming_ref") || die "the fetch stored no ref"
  [ "$(git cat-file -t "$tip")" = commit ] || die "refused: the fetched ref is not a commit"
  old=$(git rev-parse --verify --quiet "$ref" || true)
  [ -z "$old" ] || refuse_rewritten_branch "$ref" "$old" "$tip"
  refuse_oversized_tree "$tip"
  refuse_non_ascii_paths "$tip"
  refuse_repository_shapes "$tip"
  refuse_unreviewable_sensitive_change "$base" "$tip"
  store_fetched_ref "$ref" "$tip" "$old"
  print_review "$base" "$tip" "$branch"
}

refuse_failed_fetch() {
  report_partial_packs
  case "$1" in
    129 | 130 | 137 | 143) die "the fetch was stopped by a signal (exit $1); the local ref is unchanged" ;;
    *) die "the fetch failed or was refused (exit $1); the local ref is unchanged" ;;
  esac
}

refuse_rewritten_branch() {
  local ref=$1 old=$2 tip=$3 status=0 reset
  git merge-base --is-ancestor "$old" "$tip" 2>/dev/null || status=$?
  reset="To accept the VM's history, run git update-ref -d $ref and fetch again."
  case "$status" in
    0) ;;
    1) die "refused: the VM branch was rewritten, so the local ref is unchanged. $reset" ;;
    *) die "could not compare the fetched tip with $ref ($old); the local ref is unchanged. $reset" ;;
  esac
}

# The ${1+...} form keeps an empty argument list safe under set -u on old Bash.
main() {
  local command=${1:-}
  case "$command" in
    up | shell | fetch | secret)
      lain_root=$(find_lain_root "${BASH_SOURCE[0]}") ||
        die "refused: this lain-vm is not in a bin/ directory, so it has no lain root." \
          "lain-vm runs from a lain checkout."
      [ -f "$lain_root/lain.gemspec" ] ||
        die "refused: $lain_root holds no lain.gemspec. lain-vm runs from a lain checkout."
      lain_root_is_checkout ||
        die "refused: $lain_root is not a git checkout's top level. lain-vm runs from a lain checkout."
      ;;
  esac
  case "$command" in
    up) shift; cmd_up ${1+"$@"} ;;
    shell) shift; cmd_shell ${1+"$@"} ;;
    fetch) shift; cmd_fetch ${1+"$@"} ;;
    secret) shift; cmd_secret ${1+"$@"} ;;
    --help | -h | help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main ${1+"$@"}
