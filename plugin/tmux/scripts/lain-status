#!/bin/sh
# Renders the lain HUD line (warmth / fleet / inbox / approvals / context /
# mode) for a tmux status bar.
#
#   lain-status [STATE_FILE]
#
# STATE_FILE is the struct Lain::StatusFeed publishes. This script is TOLD
# that path and derives nothing: no project directory, no `.lain/`, no
# `$XDG_STATE_HOME`, and above all no `sha256(realpath(dir))[0, 12]`. That is
# the point. Since F50 the feed lives at
# `$XDG_STATE_HOME/lain/status/<project-hash>/state.json`, and resolving a
# directory to it needs a digest binary POSIX does not mandate -- while THIS
# file's whole contract is that it never blanks and never errors, with `jq`
# its one optional dependency. So resolution belongs to whoever already knows
# the directory: `lain up` interpolates an absolute path into its own
# session-scoped status-right, and `lain.tmux` resolves `#{pane_current_path}`
# per pane at render time. Both hand the answer here.
#
# No argument, or a path that is not there, is therefore not an error and not
# a bug -- it is a caller that could not resolve, and it reads as "no state
# yet" like any other absent file.
#
# The filter reads six keys ("cache_deadline","fleet","inbox_count",
# "approvals_pending","occupancy","mode_lighter") and ignores the rest; the
# last three are rendered only when present, so a state file written by an
# older lain still renders the line it always did. mode_lighter arrives
# ALREADY COMPOSED (the posture's lighter plus every active layer's, empty
# under the silent default posture), so this script carries no copy of the
# mode ladder -- see Up::Hud::JQ_FILTER. The occupancy percentage is clamped
# to 100: an unmatched model (every Ollama id, most Bedrock ids) is measured
# against ContextWindow's 8,192 conservative fallback, which can publish a
# ratio well above 1.0.
#
# The jq filter below is Lain::CLI::Up::JQ_FILTER, byte for byte -- one HUD,
# two renderers, pinned by spec (spec/plugin/tmux_plugin_spec.rb). Without
# jq the raw JSON still shows (cat), and every failure path -- no state
# file yet, corrupt state, jq mid-write race -- prints an honest
# "lain: no state yet", never an error and never a blank status segment.
set -eu

state="${1:-}"

# -s, not -f: jq -r (and cat) on a ZERO-BYTE file exits 0 with empty
# output, which would render a silently blank segment -- the exact
# never-blank violation this script exists to prevent. A zero-byte state
# file is a mid-write/truncated state and reads as "no state yet". An empty
# argument lands in the same branch, and means the caller could not resolve.
if [ -z "$state" ] || [ ! -s "$state" ]; then
  echo "lain: no state yet"
  exit 0
fi

# This is a jq filter, byte-for-byte pinned against Lain::CLI::Up::Hud::JQ_FILTER
# by the spec; single quotes keep the shell out of it. It uses NO jq variable
# (`$name`) on purpose -- see that constant's comment: tmux 3.4 escapes a `$` in
# an option value and the other renderer then feeds jq a broken filter. `\(...)`
# below is jq's interpolation, not a shell expansion.
# shellcheck disable=SC2016
JQ_FILTER='(if .cache_deadline and (.cache_deadline | fromdateiso8601) > now then "🔥" else "❄" end)
+ " fleet:\(.fleet | length) inbox:\(.inbox_count)"
+ (if (.approvals_pending // 0) > 0 then " approve:\(.approvals_pending)" else "" end)
+ (if .occupancy then " ctx:\([(.occupancy * 100 | floor), 100] | min)%" else "" end)
+ (if (.mode_lighter // "") != "" then " " + .mode_lighter else "" end)'

if command -v jq >/dev/null 2>&1; then
  jq -r "$JQ_FILTER" "$state" 2>/dev/null || echo "lain: no state yet"
else
  cat "$state" 2>/dev/null || echo "lain: no state yet"
fi
