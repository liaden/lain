#!/bin/sh
# Prints the lain HUD line (warmth / fleet / inbox / approvals / context /
# run spend / mode) for a tmux status bar.
#
#   lain-status [STATE_FILE]
#
# STATE_FILE is the struct Lain::StatusFeed publishes. This script is TOLD
# that path and derives nothing: no project directory, no `.lain/`, no
# `$XDG_STATE_HOME`, and above all no `sha256(realpath(dir))[0, 12]`. That is
# the point. The feed lives at
# `$XDG_STATE_HOME/lain/status/<project-hash>/state.json`, and resolving a
# directory to it needs a digest binary POSIX does not mandate -- while THIS
# file's whole contract is that it never blanks and never errors. So
# resolution belongs to whoever already knows the directory: `lain up`
# interpolates an absolute path into its own session-scoped status-right, and
# `lain.tmux` resolves `#{pane_current_path}` per pane at render time. Both
# hand the answer here.
#
# No argument, or a path that is not there, is therefore not an error and not
# a bug -- it is a caller that could not resolve, and it reads as "no state
# yet" like any other absent file.
#
# IT DERIVES NOTHING FROM THE STRUCT EITHER. The line arrives ALREADY
# RENDERED, in the feed's own `hud` field, composed by
# Lain::StatusFeed::Reading -- glyph, counts, the clamped context percentage,
# the run's token spend and the composed mode lighter, all of it. This file
# used to carry a jq program that was a byte-for-byte copy of the Ruby one,
# which is two spellings of one HUD and a hard dependency on a binary POSIX
# does not mandate. Both are gone: picking one field out of one line is a
# shell builtin, so nothing here needs a single binary on PATH.
#
# WHAT THE PRE-RENDERED FIELD COSTS is freshness of the warm/cold marker. jq
# re-evaluated `now` on every status-interval tick; this prints the marker the
# last PUBLISH earned, and a publish happens on an event. An idle session
# therefore shows its last turn's marker however long it sits, and past the
# provider's cache window that marker is wrong -- optimistically, 🔥 where the
# truth is ❄. No surface is better off: lain's terminal prompt composes its own
# marker once per input cycle, so it is stamped at the turn boundary too. This
# job was the only one that re-evaluated on a timer, and keeping it meant
# keeping a second spelling of the whole HUD.
#
# Every failure path -- no state file yet, a truncated or corrupt state, a
# file written by a lain too old to publish the line -- prints an honest
# "lain: no state yet", never an error and never a blank status segment.
set -eu

state="${1:-}"

# -s, not -f alone: a ZERO-BYTE file would yield no field and render a
# silently blank segment -- the exact never-blank violation this script exists
# to prevent. A zero-byte state file is a mid-write/truncated state and reads
# as "no state yet". An empty argument lands in the same branch, and means the
# caller could not resolve. `-f` and `-r` are here so an unreadable path or a
# directory cannot fail the redirection below, which under `set -e` would exit
# with a shell diagnostic instead of the honest sentence.
if [ -z "$state" ] || [ ! -f "$state" ] || [ ! -r "$state" ] || [ ! -s "$state" ]; then
  printf '%s\n' "lain: no state yet"
  exit 0
fi

# `"hud":"<line>"` out of the published JSON, with parameter expansion alone.
# Ending the field at the first `"` is sound rather than lucky: the publisher
# (Lain::StatusFeed::Reading) strips `"`, `\` and `#` out of the one segment
# that is free-form, and every other segment is a count or a clamped
# percentage -- so no JSON parser is needed to find where the value stops. The
# exact spelling is JSON.generate's, which is the only writer this file ever
# reads. `read` rather than `cat` keeps the whole thing free of PATH, and the
# loop finds the field wherever in the file it sits rather than assuming one
# line.
line=""
hud=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    *'"hud":"'*)
      rest=${line#*'"hud":"'}
      hud=${rest%%'"'*}
      ;;
  esac
done <"$state"

# Empty covers both "no such field" (a lain too old to publish it) and a field
# published empty, and the never-blank contract makes the sentence the answer
# to both. printf rather than echo, because the line is data from upstream and
# `echo` would read a leading `-n` as a flag -- and printf is a builtin in
# every shell that ships as /bin/sh, so it costs nothing of the no-PATH
# property above.
if [ -n "$hud" ]; then
  printf '%s\n' "$hud"
else
  printf '%s\n' "lain: no state yet"
fi
