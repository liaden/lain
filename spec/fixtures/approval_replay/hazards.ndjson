{"hazard":"redirect writes outside the root","command":"cat notes.md > /tmp/out.txt"}
{"hazard":"secret read .env","command":"cat .env"}
{"hazard":"secret read ssh key","command":"cat ~/.ssh/id_rsa"}
{"hazard":"read above the root","command":"cat ../x"}
