  # `lain up`'s chat pre-flight, run in a fork of this already-loaded process
  # rather than a second boot. It lives here because the child must name
  # LainCLI and own fds 1 and 2, and lib/ does neither.
  class ChatPreflightFork
    Answer = Data.define(:stdout, :stderr, :exitstatus)

    # Every exception a spawned Ruby prints before exiting 1. SystemExit carries chat's own
    # status, and a SignalException ends the child as it would end a spawned one. An
    # Exception subclass defined outside core is not caught: it exits 1 with no message.
    CRASHES = [StandardError, ScriptError, NoMemoryError, SecurityError, SystemStackError].freeze

    # @return [Hash] the keywords Up takes; empty where fork is missing, so Up spawns instead
    def self.wiring
      return {} unless Process.respond_to?(:fork)

      { preflight_run: new(starter: ->(args) { LainCLI.start(["chat", *args]) }) }
    end

    # @param starter [#call] runs chat with the given argv in the child
    def initialize(starter:)
      @starter = starter
    end

    # @return [Answer]
    # @raise [Errno::ENOENT] when cwd is missing, which is a check that could not run
    # @raise [Lain::Shell::Out::Timeout] after the child was killed
    def call(args, cwd:, environment:, timeout:)
      raise Errno::ENOENT, cwd unless File.directory?(cwd)

      pipes = Lain::Shell::Out::Pipes.new
      answer = Answer.new(stdout: +"", stderr: +"", exitstatus: nil)
      bounded = Lain::Shell::Out::Bounded.new(timeout:, clock: Lain::RunClock::MONOTONIC,
                                              command: ["lain", "chat", *args])
      status = bounded.call(pipes.readers(answer.stdout, answer.stderr)) { forked(args, cwd:, environment:, pipes:) }
      answer.with(exitstatus: status)
    ensure
      pipes&.close
    end

    private

    def forked(args, cwd:, environment:, pipes:)
      pid = fork { child(args, cwd:, environment:, **pipes.redirection) }
      pipes.close_writes
      lead(pid)
      pid
    end

    # Set from both sides, so a stop that races the child's own setpgid still finds the group.
    def lead(pid)
      Process.setpgid(pid, pid)
    rescue SystemCallError
      nil
    end

    # Leaves by `exit!` whatever happens, so no at_exit hook of the parent runs
    # here and the fork never returns into the parent's code. Interrupts are
    # let in again because the fork happened while the parent deferred them,
    # and a TERM must still stop a hung check. A signal ends it by that signal,
    # so the parent reads a killed check rather than a refusal.
    def child(args, **pane)
      status = 1
      begin
        stand_in_pane(**pane)
        status = Thread.handle_interrupt(Object => :immediate) { chat_status(args) }
      rescue SignalException => e
        signalled = e.signo
      ensure
        $stdout.flush
        $stderr.flush
        die_by(signalled) if signalled
        exit!(status)
      end
    end

    def stand_in_pane(cwd:, environment:, out:, err:)
      Process.setpgid(0, 0)
      $stdin.reopen(File::NULL)
      $stdout.reopen(out)
      $stderr.reopen(err)
      Dir.chdir(cwd)
      ENV.update(environment)
      Lain::Config.forget!
    end

    # SYSTEM_DEFAULT, the kernel's action; Ruby's own "DEFAULT" for TERM raises again.
    def die_by(signo)
      Signal.trap(signo, "SYSTEM_DEFAULT")
      Process.kill(signo, Process.pid)
    rescue ArgumentError
      nil
    end

    def chat_status(args)
      @starter.call(args)
      0
    rescue SystemExit => e
      e.status
    rescue *CRASHES => e
      $stderr.write(e.full_message(highlight: false))
      1
    end
  end

  desc "up [PATH] [-- CHAT_FLAGS...]",
       "Create/attach the lain tmux session in PATH (editor | chat transcript over an input pane, + status HUD)"
  method_option :session, type: :string, default: Lain::CLI::Up::DEFAULT_SESSION, desc: "tmux session name"
  method_option :socket, type: :string, desc: "tmux socket (-L); default tmux socket when unset"
  # BOOLEAN, and that is what makes `lain up --nvim PATH` mean what it reads
  # like. It took an optional value until the PATH argument landed, and an
  # optional-value flag consumes the next token -- so `--nvim /tmp/repo`
  # listened on a socket called `/tmp/repo` and the session got no PATH at
  # all. A valueless boolean cannot swallow anything, `--no-nvim` is Thor's
  # own negation of it, and the explicit socket moved to its own flag.
  method_option :nvim, type: :boolean, default: true,
                       desc: "Add the nvim pane beside the chat (the default); --no-nvim for chat alone. " \
                             "The input pane under the chat transcript is there either way"
  method_option :nvim_socket, type: :string, banner: "PATH",
                              desc: "Listen on this nvim socket instead of the per-project one lain derives"
  method_option :create, type: :boolean, default: false,
                         desc: "Make PATH if it does not exist (its parent must)"
  def up(path = nil, *chat_args)
    # ENV.key?("TMUX") is THIS shell's own answer to "am I already an
    # attached tmux client" -- Up#attach_command turns that into the right
    # verb (switch-client vs. attach); see its doc comment for why the
    # branch has to happen before exec, and the cross-server known gap.
    plan = Lain::CLI::Up.from_options(options, **up_argv(path, chat_args), **ChatPreflightFork.wiring)
                        .launch_plan(nested: ENV.key?("TMUX"))
    plan.messages.each { |line| say(line) }
    # exec REPLACES this process, so nothing after this line ever runs --
    # flush stdout first: `say`'s writes above are not guaranteed flushed
    # yet when stdout isn't a TTY (no at_exit/implicit flush fires once
    # exec has taken over).
    $stdout.flush
    Kernel.exec(*plan.argv)
  rescue Lain::Error => e
    raise Thor::Error, e.message
  end
end

# Guarded so a spec can `load` this file to reach the Thor class itself
# (cli_spec.rb driving LainCLI and its Backend alias -- the assembly seams now
# live in Lain::CLI::Wiring) without parsing ARGV or hitting the network. Direct execution
# compares paths; an INSTALLED gem runs through the RubyGems binstub, which
# `load`s this file with $0 still naming the wrapper -- the wrapper's basename
# is also "lain", which a spec's $0 (rspec) never is. Found by the gem-install
# smoke: the path-only guard made the installed executable a silent no-op.
LainCLI.start(ARGV) if $PROGRAM_NAME == __FILE__ || File.basename($PROGRAM_NAME) == File.basename(__FILE__)
